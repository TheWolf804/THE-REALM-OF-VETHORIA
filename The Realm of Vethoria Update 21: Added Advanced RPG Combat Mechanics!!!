void BossManager::Update(float dt, Vector2 playerPos, float playerDef, float& playerHP, ParticleEngine& particles) {
    if (hp <= 0) return;
    
    timer += dt;
    if (!enraged && hp <= (maxHP * 0.5f)) { enraged = true; dmg = 40.0f; }

    switch (state) {
        case BOSS_IDLE: 
            if (timer >= 0.5f) { state = BOSS_CHASE; timer = 0.0f; } 
            break;
        case BOSS_CHASE: {
            Vector2 dir = Vector2Normalize(Vector2Subtract(playerPos, pos));
            pos = Vector2Add(pos, Vector2Scale(dir, (enraged ? 170.0f : 110.0f) * dt));
            if (Vector2Distance(pos, playerPos) < 160.0f || timer > 3.0f) {
                state = BOSS_TELEGRAPH; timer = 0.0f; attackTarget = playerPos;
            }
        } break;
        case BOSS_TELEGRAPH: {
            telegraphProgress = timer / (enraged ? 0.6f : 1.2f);
            if (timer >= (enraged ? 0.6f : 1.2f)) { state = BOSS_ATTACK; timer = 0.0f; }
        } break;
        case BOSS_ATTACK: {
            particles.Emit(attackTarget, RED, 30, 150.0f, 400.0f);
            // Note: In full loop, player invulnerability check will prevent damage during Dodge Rolls!
            if (Vector2Distance(playerPos, attackTarget) <= 120.0f) {
                float finalDmg = (dmg - playerDef > 5.0f) ? dmg - playerDef : 5.0f;
                playerHP -= finalDmg;
            }
            state = BOSS_COOLDOWN; timer = 0.0f;
        } break;
        case BOSS_COOLDOWN: 
            if (timer >= 1.0f) { state = BOSS_CHASE; timer = 0.0f; } 
            break;
    }
}
#include "raylib.h"
#include "Common.h"
#include "ParticleEngine.h"
#include "Player.h"
#include "BossManager.h"
#include "WorldManager.h"

int main() {
    const int screenW = 1280, screenH = 720;
    InitWindow(screenW, screenH, "Vethoria: Advanced RPG Combat Engine");
    SetTargetFPS(60);

    Player player;
    BossManager boss;
    WorldManager world;
    ParticleEngine particles;

    while (!WindowShouldClose()) {
        float dt = GetFrameTime();

        // 1. Update Core Engines
        player.Update(dt, particles);
        
        // Handle Boss Combat & Dodge Roll i-Frame Protection
        float dummyHP = player.health;
        boss.Update(dt, player.pos, (float)player.totalDefense, dummyHP, particles);
        if (!player.isInvulnerable) {
            player.health = dummyHP;
        }

        particles.Update(dt);

        // 2. Fireball vs Boss Collisions
        for (auto& spell : player.activeSpells) {
            if (spell.active && boss.hp > 0) {
                if (CheckCollisionCircles(spell.pos, spell.radius, boss.pos, 35.0f)) {
                    boss.hp -= spell.damage;
                    spell.active = false;
                    particles.Emit(spell.pos, GOLD, 25, 100.0f, 300.0f);
                }
            }
        }

        // 3. Render Pass
        BeginDrawing();
        ClearBackground(BLACK);

        world.DrawCurrentRoom();
        boss.Draw();
        player.Draw();
        particles.Draw();

        // Overlay UIs
        player.DrawHUD();
        player.DrawSkillTreeUI();

        DrawRectangle(0, screenH - 30, screenW, 30, GetColor(0x12121AFF));
        DrawText("[WASD] Move | [SPACE] Dodge Roll | [RMB] Fireball | [K] Skill Tree | [E] Inventory", 20, screenH - 22, 13, LIGHTGRAY);

        EndDrawing();
    }

    CloseWindow();
    return 0;
}

