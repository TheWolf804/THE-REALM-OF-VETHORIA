class EngineBugFixesV3Manager {
public:
    void InitStabilityPass3() {
        std::cout << "[BugFixes v3.0] Initializing advanced audio de-clicking and collision safety layers..." << std::endl;
    }

    // Fix Issue 1: De-clicking envelope filter for procedural audio generation
    float ApplyAudioEnvelope(float rawSample, float& currentGain, float targetGain, float smoothingSpeed = 0.1f) {
        currentGain += (targetGain - currentGain) * smoothingSpeed;
        return rawSample * currentGain;
    }

    // Fix Issue 2: Compute Letterbox / Pillarbox Viewport to prevent screen distortion
    Rectangle GetLetterboxedViewport(int windowW, int windowH, int gameW = 1280, int gameH = 720) {
        float targetAspect = (float)gameW / (float)gameH;
        float windowAspect = (float)windowW / (float)windowH;

        float viewW, viewH, viewX, viewY;

        if (windowAspect > targetAspect) {
            // Window is wider than target -> Pillarbox (bars on sides)
            viewH = (float)windowH;
            viewW = viewH * targetAspect;
            viewX = (windowW - viewW) * 0.5f;
            viewY = 0.0f;
        } else {
            // Window is taller than target -> Letterbox (bars on top/bottom)
            viewW = (float)windowW;
            viewH = viewW / targetAspect;
            viewX = 0.0f;
            viewY = (windowH - viewH) * 0.5f;
        }

        return { viewX, viewY, viewW, viewH };
    }

    // Fix Issue 3: Continuous Collision Detection (Ray-Circle) to prevent projectile tunneling
    bool CheckProjectileWallCollision(Vector2 rayStart, Vector2 rayEnd, Vector2 wallCenter, float wallRadius) {
        Vector2 d = Vector2Subtract(rayEnd, rayStart);
        Vector2 f = Vector2Subtract(rayStart, wallCenter);

        float a = Vector2DotProduct(d, d);
        if (a == 0.0f) return false;

        float b = 2.0f * Vector2DotProduct(f, d);
        float c = Vector2DotProduct(f, f) - (wallRadius * wallRadius);

        float discriminant = (b * b) - (4.0f * a * c);
        if (discriminant < 0.0f) {
            return false;
        } else {
            discriminant = sqrtf(discriminant);
            float t1 = (-b - discriminant) / (2.0f * a);
            float t2 = (-b + discriminant) / (2.0f * a);

            if ((t1 >= 0.0f && t1 <= 1.0f) || (t2 >= 0.0f && t2 <= 1.0f)) {
                return true; // Collision detected along trajectory
            }
        }
        return false;
    }

    void DrawStabilityV3HUD(int screenW) {
        DrawRectangle(screenW - 240, 95, 225, 26, ColorAlpha(BLACK, 0.8f));
        DrawRectangleLines(screenW - 240, 95, 225, 26, SKYBLUE);
        DrawText("STABILITY PASS 3.0 ACTIVE", screenW - 232, 101, 10, SKYBLUE);
    }
