int main() {
    const int screenW = 1280, screenH = 720;
    InitWindow(screenW, screenH, "Vethoria: Bug Fixes Update 3.0");
    SetTargetFPS(60);

    Player player;
    ParticleEngine particles;
    LightEngine lighting(screenW, screenH);
    CameraManager cameraMgr(screenW, screenH);
    PostProcessingManager postFX;
    DialogueAndTownManager town;
    AudioManager audio;
    ClassAndComboManager classMgr;
    EngineBugFixesV3Manager bugFixesV3;

    postFX.Init(screenW, screenH);
    town.InitHub();
    audio.Init();
    classMgr.Init();
    bugFixesV3.InitStabilityPass3();

    player.pos = { 640.0f, 360.0f };

    while (!WindowShouldClose()) {
        float dt = GetFrameTime();
        Vector2 mousePos = GetMousePosition();

        ClassProfile prof = classMgr.GetCurrentProfile();
        player.maxHealth = prof.maxHealth;

        classMgr.Update(dt, player.pos, particles);

        if (IsMouseButtonPressed(MOUSE_BUTTON_LEFT)) {
            Vector2 aimDir = Vector2Subtract(GetScreenToWorld2D(mousePos, cameraMgr.camera), player.pos);
            classMgr.TriggerAttack(player.pos, aimDir);

            // Test Continuous Collision Detection for Projectiles
            bool hitObstacle = bugFixesV3.CheckProjectileWallCollision(player.pos, Vector2Add(player.pos, Vector2Scale(aimDir, 200.0f)), { 700.0f, 360.0f }, 30.0f);
            if (hitObstacle) {
                // Projectile intercepted
            }
        }

        player.Update(dt, particles);
        particles.Update(dt);
        cameraMgr.Update(player.pos, player.pos, false, dt);

        // Render Frame Pass with Aspect Ratio Scaling Shield
        Rectangle viewport = bugFixesV3.GetLetterboxedViewport(GetScreenWidth(), GetScreenHeight());

        postFX.BeginRenderPass();
            cameraMgr.BeginMode();
                town.DrawHubWorld(player.pos);
                classMgr.DrawAttackVisuals(player.pos);
                player.Draw();
                particles.Draw();

                lighting.BeginLightPass();
                lighting.DrawLight(player.pos, 260.0f, prof.themeColor, 0.85f);
                lighting.EndLightPass(GetColor(0x181822FF));
            cameraMgr.EndMode();
        
        postFX.EndRenderPassAndApplyFX(dt, player.health, player.maxHealth, GetScreenWidth(), GetScreenHeight());

        // HUD & Overlays
        player.DrawHUD();
        classMgr.DrawClassAndAbilityHUD(GetScreenWidth(), GetScreenHeight());
        bugFixesV3.DrawStabilityV3HUD(GetScreenWidth());

        DrawText("BUG FIXES 3.0 [AUDIO DE-CLICK & CCD ACTIVE]", 15, 15, 11, SKYBLUE);

        EndDrawing();
    }

    audio.Unload();
    postFX.Unload();
    CloseWindow();
    return 0;
}
};
