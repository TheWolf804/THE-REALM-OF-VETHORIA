enum GameState { STATE_MENU, STATE_SETTINGS, STATE_GAMEPLAY };
enum Rarity { RARITY_COMMON, RARITY_UNCOMMON, RARITY_RARE, RARITY_EPIC, RARITY_LEGENDARY };
enum ItemType { ITEM_WEAPON, ITEM_ARMOR, ITEM_POTION };

struct Item {
    char name[32]; // Fixed-size char array for clean binary serialization
    ItemType type;
    Rarity rarity;
    int bonusAttack;
    int bonusDefense;
    int bonusHealth;
    Color color;
};

Color GetRarityColor(Rarity r);

struct SpellProjectile {
    Vector2 pos;
    Vector2 vel;
    float radius;
    float damage;
    float lifetime;
    bool active = false;
};

// Binary Save File Structure
struct SaveData {
    int level;
    int skillPoints;
    int strPoints;
    int agiPoints;
    int intPoints;
    float health;
    float maxHealth;
    int currentRoom;
    Item inventory[16];
    bool slotOccupied[16];
