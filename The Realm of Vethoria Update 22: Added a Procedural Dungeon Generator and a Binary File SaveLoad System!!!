const int MAP_COLS = 16, MAP_ROWS = 10, TILE_SIZE = 80;

class WorldManager {
public:
    int currentRoom = 0;
    int dungeonFloor[MAP_ROWS][MAP_COLS];
    Vector2 playerSpawn = { 160.0f, 160.0f };
    Vector2 exitPortal = { 1120.0f, 560.0f };

    WorldManager();
    void GenerateProceduralDungeon(int seed);
    void DrawCurrentRoom();
    bool IsWallTile(Vector2 worldPos);
    bool CheckExitCollision(Vector2 playerPos);
};
#include "WorldManager.h"
#include <cstdlib>

WorldManager::WorldManager() {
    GenerateProceduralDungeon(12345);
}

void WorldManager::GenerateProceduralDungeon(int seed) {
    SetRandomSeed(seed);

    // 1. Fill map with solid walls (1 = Wall, 0 = Floor, 2 = Exit Portal)
    for (int r = 0; r < MAP_ROWS; r++) {
        for (int c = 0; c < MAP_COLS; c++) {
            dungeonFloor[r][c] = 1;
        }
    }

    // 2. Random Walk Carving Algorithm
    int startX = 2, startY = 2;
    int currX = startX, currY = startY;
    dungeonFloor[currY][currX] = 0;
    playerSpawn = { (float)currX * TILE_SIZE + 40.0f, (float)currY * TILE_SIZE + 40.0f };

    int floorTilesTarget = 65;
    int carved = 1;

    int dirs[4][2] = { {0, -1}, {0, 1}, {-1, 0}, {1, 0} };

    while (carved < floorTilesTarget) {
        int dirIndex = GetRandomValue(0, 3);
        int nextX = currX + dirs[dirIndex][0];
        int nextY = currY + dirs[dirIndex][1];

        // Keep walker inside map borders
        if (nextX >= 1 && nextX < MAP_COLS - 1 && nextY >= 1 && nextY < MAP_ROWS - 1) {
            if (dungeonFloor[nextY][nextX] == 1) {
                dungeonFloor[nextY][nextX] = 0;
                carved++;
            }
            currX = nextX;
            currY = nextY;
        }
    }

    // 3. Place Exit Portal on the last carved tile
    dungeonFloor[currY][currX] = 2;
    exitPortal = { (float)currX * TILE_SIZE + 40.0f, (float)currY * TILE_SIZE + 40.0f };
}

bool WorldManager::IsWallTile(Vector2 worldPos) {
    int c = (int)(worldPos.x / TILE_SIZE);
    int r = (int)(worldPos.y / TILE_SIZE);
    if (r < 0 || r >= MAP_ROWS || c < 0 || c >= MAP_COLS) return true;
    return (dungeonFloor[r][c] == 1);
}

bool WorldManager::CheckExitCollision(Vector2 playerPos) {
    return (Vector2Distance(playerPos, exitPortal) < 35.0f);
}

void WorldManager::DrawCurrentRoom() {
    Color wallCol = GetColor(0x222230FF);
    Color floorCol = GetColor(0x14141EFF);

    for (int r = 0; r < MAP_ROWS; r++) {
        for (int c = 0; c < MAP_COLS; c++) {
            Rectangle tileRec = { (float)c * TILE_SIZE, (float)r * TILE_SIZE, (float)TILE_SIZE, (float)TILE_SIZE };
            int type = dungeonFloor[r][c];

            if (type == 1) DrawRectangleRec(tileRec, wallCol);
            else if (type == 0) DrawRectangleRec(tileRec, floorCol);
            else if (type == 2) {
                DrawRectangleRec(tileRec, floorCol);
                DrawCircleV(exitPortal, 25.0f, Fade(PURPLE, 0.6f));
                DrawCircleLines(exitPortal.x, exitPortal.y, 25.0f, VIOLET);
            }
            DrawRectangleLinesEx(tileRec, 1, GetColor(0x101018FF));
        }
    }
}
