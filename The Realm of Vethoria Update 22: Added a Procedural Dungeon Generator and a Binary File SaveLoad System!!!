#include "WorldManager.h"

int main() {
    const int screenW = 1280, screenH = 720;
    InitWindow(screenW, screenH, "Vethoria: Procedural RPG & Save Engine");
    SetTargetFPS(60);

    Player player;
    BossManager boss;
    WorldManager world;
    ParticleEngine particles;

    player.pos = world.playerSpawn;
    std::string notification = "";
    float notifTimer = 0.0f;

    while (!WindowShouldClose()) {
        float dt = GetFrameTime();

        // 1. Save & Load Inputs
        if (IsKeyPressed(KEY_F5)) {
            if (player.SaveToFile("savegame.dat", world.currentRoom)) {
                notification = "GAME SAVED TO 'savegame.dat'!";
                notifTimer = 2.5f;
            }
        }
        if (IsKeyPressed(KEY_F9)) {
            if (player.LoadFromFile("savegame.dat", world.currentRoom)) {
                world.GenerateProceduralDungeon(100 + world.currentRoom * 55);
                player.pos = world.playerSpawn;
                notification = "GAME LOADED SUCCESSFULLY!";
                notifTimer = 2.5f;
            }
        }

        // 2. Room Transition / Portal Step
        if (world.CheckExitCollision(player.pos)) {
            world.currentRoom++;
            world.GenerateProceduralDungeon(GetRandomValue(1, 99999));
            player.pos = world.playerSpawn;
            boss.hp = boss.maxHP; // Reset boss on new floor
            notification = TextFormat("ENTERED DUNGEON FLOOR %d", world.currentRoom + 1);
            notifTimer = 2.5f;
        }

        // 3. Engine Updates
        player.Update(dt, particles);
        
        float dummyHP = player.health;
        boss.Update(dt, player.pos, (float)player.totalDefense, dummyHP, particles);
        if (!player.isInvulnerable) player.health = dummyHP;

        particles.Update(dt);

        // Spell Hit Collisions
        for (auto& spell : player.activeSpells) {
            if (spell.active && boss.hp > 0) {
                if (CheckCollisionCircles(spell.pos, spell.radius, boss.pos, 35.0f)) {
                    boss.hp -= spell.damage;
                    spell.active = false;
                    particles.Emit(spell.pos, GOLD, 25, 100.0f, 300.0f);
                }
            }
        }

        if (notifTimer > 0) notifTimer -= dt;

        // 4. Render Frame
        BeginDrawing();
        ClearBackground(BLACK);

        world.DrawCurrentRoom();
        boss.Draw();
        player.Draw();
        particles.Draw();

        player.DrawHUD();
        player.DrawSkillTreeUI();
        player.DrawInventoryUI();

        // Save/Load Notifications
        if (notifTimer > 0.0f) {
            DrawRectangle(screenW / 2 - 200, 20, 400, 35, GetColor(0x000000D0));
            DrawRectangleLines(screenW / 2 - 200, 20, 400, 35, GOLD);
            DrawText(notification.c_str(), screenW / 2 - MeasureText(notification.c_str(), 14) / 2, 30, 14, GOLD);
        }

        // Controls Bar
        DrawRectangle(0, screenH - 30, screenW, 30, GetColor(0x12121AFF));
        DrawText("[WASD] Move | [SPACE] Roll | [RMB] Fireball | [K] Skill Tree | [F5] Save | [F9] Load", 20, screenH - 22, 13, LIGHTGRAY);

        EndDrawing();
    }

    CloseWindow();
    return 0;
}
