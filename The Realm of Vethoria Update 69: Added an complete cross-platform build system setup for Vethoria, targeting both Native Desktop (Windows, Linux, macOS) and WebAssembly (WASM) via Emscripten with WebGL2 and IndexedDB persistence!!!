cmake_minimum_required(VERSION 3.16)
project(Vethoria VERSION 1.0.0 LANGUAGES CXX C)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)

# Include Directories
include_directories(include)

# Collect Source Files
file(GLOB_RECURSE SOURCES "src/*.cpp")

# Check if compiling with Emscripten WebAssembly Toolchain
if(EMSCRIPTEN)
    message(STATUS "Building Vethoria for WebAssembly (Emscripten)...")

    set(TARGET_NAME "vethoria.html")
    add_executable(${TARGET_NAME} ${SOURCES})

    # Emscripten Compiler & Linker Flags
    set(EMSCRIPTEN_LINK_FLAGS
        "-s USE_GLFW=3"
        "-s USE_WEBGL2=1"
        "-s FULL_ES3=1"
        "-s ALLOW_MEMORY_GROWTH=1"
        "-s WASM=1"
        "-s FORCE_FILESYSTEM=1"
        "-s IDBFS=1"
        "-s EXPORTED_RUNTIME_METHODS=['ccall','cwrap','FS']"
        "-s ASYNCIFY"
        "--shell-file ${CMAKE_SOURCE_DIR}/wasm/shell.html"
        "-O3"
    )

    # Join flags into string
    string(REJOIN " " LINK_FLAGS_STR ${EMSCRIPTEN_LINK_FLAGS})
    set_target_properties(${TARGET_NAME} PROPERTIES LINK_FLAGS "${LINK_FLAGS_STR}")

    # Raylib WASM dependency link
    find_package(raylib REQUIRED)
    target_link_libraries(${TARGET_NAME} PRIVATE raylib)

else()
    message(STATUS "Building Vethoria for Native Desktop Environment...")

    set(TARGET_NAME "vethoria")
    add_executable(${TARGET_NAME} ${SOURCES})

    # Find System or Local Raylib Package
    find_package(raylib 4.5 QUIET)
    if(NOT raylib_FOUND)
        message(STATUS "Fetching Raylib via FetchContent...")
        include(FetchContent)
        FetchContent_Declare(
            raylib
            URL https://github.com/raysan5/raylib/archive/refs/tags/4.5.0.tar.gz
        )
        set(BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
        FetchContent_MakeAvailable(raylib)
    endif()

    target_link_libraries(${TARGET_NAME} PRIVATE raylib)

    if(WIN32)
        target_link_libraries(${TARGET_NAME} PRIVATE winmm ws2_32)
    elseif(UNIX AND NOT APPLE)
        target_link_libraries(${TARGET_NAME} PRIVATE m pthread dl)
    endif()
