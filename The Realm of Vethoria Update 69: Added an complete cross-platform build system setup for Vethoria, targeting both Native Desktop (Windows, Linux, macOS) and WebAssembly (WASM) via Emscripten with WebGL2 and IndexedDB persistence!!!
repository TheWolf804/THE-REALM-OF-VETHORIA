    <div id="canvas-container">
        <div id="loading-overlay">
            <div class="spinner"></div>
            <div id="status-text">Mounting IndexedDB & Loading Vethoria WASM...</div>
        </div>
        <canvas class="emscripten" id="canvas" oncontextmenu="event.preventDefault()" tabindex="-1"></canvas>
    </div>

    <script type="text/javascript">
        var Module = {
            preRun: [function() {
                // Create & Mount Persistent IDBFS virtual directory at /saves
                FS.mkdir('/saves');
                FS.mount(IDBFS, {}, '/saves');
                FS.syncfs(true, function (err) {
                    if (err) console.error("IDBFS Sync Error:", err);
                    else console.log("IDBFS Save Directory Synced successfully.");
                });
            }],
            postRun: [function() {
                document.getElementById('loading-overlay').style.display = 'none';
            }],
            canvas: (function() {
                var canvas = document.getElementById('canvas');
                return canvas;
            })(),
            setStatus: function(text) {
                if (text) document.getElementById('status-text').innerText = text;
            }
        };
    </script>
