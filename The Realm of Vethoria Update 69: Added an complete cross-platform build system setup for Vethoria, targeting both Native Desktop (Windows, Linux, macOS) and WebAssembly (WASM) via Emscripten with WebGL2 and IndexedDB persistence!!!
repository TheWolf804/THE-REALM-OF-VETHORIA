#!/bin/bash
set -e

BUILD_TYPE=${1:-native}

if [ "$BUILD_TYPE" == "wasm" ]; then
    echo "=================================================="
    echo "       Building Vethoria WebAssembly Target        "
    echo "=================================================="
    
    mkdir -p build_wasm
    cd build_wasm
    
    # Configure with Emscripten CMake wrapper
    emcmake cmake .. -DCMAKE_BUILD_TYPE=Release
    emmake make -j$(nproc)
    
    echo "WASM Build Complete! Files generated in build_wasm/vethoria.html"
    echo "Run 'emrun vethoria.html' or serve via a local HTTP server."
    
else
    echo "=================================================="
    echo "        Building Vethoria Native Desktop          "
    echo "=================================================="
    
    mkdir -p build_native
    cd build_native
    
    cmake .. -DCMAKE_BUILD_TYPE=Release
    make -j$(nproc)
    
    echo "Native Build Complete! Executable binary at build_native/vethoria"
fi

endif()
