#pragma once
#include "raylib.h"
#include <unordered_map>
#include <string>

class TextureManager {
private:
    std::unordered_map<std::string, Texture2D> textures;
    Texture2D fallbackTexture;
    bool fallbackCreated = false;

    void CreateFallbackTexture();

public:
    TextureManager();
    ~TextureManager();

    void LoadAll();
    bool LoadTextureAuto(const std::string& key, const std::string& filepath);
    Texture2D Get(const std::string& key);
    void UnloadAll();
};
#include "TextureManager.h"
#include <iostream>

TextureManager::TextureManager() {}

TextureManager::~TextureManager() {
    UnloadAll();
}

void TextureManager::CreateFallbackTexture() {
    if (fallbackCreated) return;
    
    // Generate a 32x32 pink/black checkerboard pattern for missing textures
    Image img = GenImageChecked(32, 32, 8, 8, PINK, BLACK);
    fallbackTexture = LoadTextureFromImage(img);
    UnloadImage(img);
    fallbackCreated = true;
}

void TextureManager::LoadAll() {
    CreateFallbackTexture();

    // Preload game texture assets
    LoadTextureAuto("player", "assets/player.png");
    LoadTextureAuto("boss", "assets/boss.png");
    LoadTextureAuto("minion", "assets/skeleton.png");
    LoadTextureAuto("wall", "assets/wall.png");
    LoadTextureAuto("floor", "assets/floor.png");
    LoadTextureAuto("portal", "assets/portal.png");
}

bool TextureManager::LoadTextureAuto(const std::string& key, const std::string& filepath) {
    if (FileExists(filepath.c_str())) {
        Texture2D tex = LoadTexture(filepath.c_str());
        if (tex.id > 0) {
            textures[key] = tex;
            return true;
        }
    }
    // Store fallback texture if loading failed or file missing
    textures[key] = fallbackTexture;
    return false;
}

Texture2D TextureManager::Get(const std::string& key) {
    auto it = textures.find(key);
    if (it != textures.end()) {
        return it->second;
    }
    return fallbackTexture;
}

void TextureManager::UnloadAll() {
    for (auto& pair : textures) {
        if (pair.second.id != fallbackTexture.id && pair.second.id > 0) {
            UnloadTexture(pair.second);
        }
    }
    textures.clear();

    if (fallbackCreated && fallbackTexture.id > 0) {
        UnloadTexture(fallbackTexture);
        fallbackCreated = false;
    }
}
