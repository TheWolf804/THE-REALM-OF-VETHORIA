#include "raylib.h"
#include "raymath.h"
#include <vector>
#include <string>

// Enum for Skill Tree Branches
enum SkillBranch {
    BRANCH_VANGUARD,
    BRANCH_AETHER,
    BRANCH_UTILITY
};

// Skill Node Structure
struct SkillNode {
    int id;
    std::string name;
    std::string description;
    SkillBranch branch;
    Vector2 gridPos;
    int cost;
    int requiredLevel;
    bool unlocked;
    int prerequisiteId; // -1 if root node
};

// Player Progression & Level Cap Engine
struct PlayerProgression {
    static const int MAX_LEVEL = 50;
    
    int level = 1;
    int currentXP = 0;
    int xpToNextLevel = 100;
    int skillPoints = 5; // Starting allocation for testing
    int attributePoints = 0;

    // Base Combat Attributes
    float maxHealth = 100.0f;
    float attackPowerMultiplier = 1.0f;
    float moveSpeedMultiplier = 1.0f;
    float critChance = 0.05f;
    float parryReflectMultiplier = 1.0f;
    bool hasDragonStanceUnlocked = false;
    bool hasOverloadBeamUnlocked = false;
    bool hasImmortalityUnlocked = false;
};

// 18 Expanded Skill Nodes
std::vector<SkillNode> skillTree = {
    // === VANGUARD BRANCH (MELEE) ===
    { 1, "Blade Polish", "Increases Melee Attack Damage by +15%.", BRANCH_VANGUARD, { 200, 200 }, 1, 1, false, -1 },
    { 2, "Executioner", "Grants +15% Critical Strike Chance on combos.", BRANCH_VANGUARD, { 200, 290 }, 1, 5, false, 1 },
    { 3, "Tiger Drop", "Parries reflect 200% damage back at foes.", BRANCH_VANGUARD, { 200, 380 }, 2, 15, false, 2 },
    { 4, "Cleave Strike", "Combo finisher hits all targets in a wide arc.", BRANCH_VANGUARD, { 140, 470 }, 2, 25, false, 3 },
    { 5, "Stance Synergy", "Swapping stances mid-combo grants +20% attack speed.", BRANCH_VANGUARD, { 260, 470 }, 2, 25, false, 3 },
    { 6, "APEX: DRAGON STANCE", "Unlocks the ultimate brawling stance with hyper-armor.", BRANCH_VANGUARD, { 200, 560 }, 5, 50, false, 4 },

    // === AETHER BRANCH (RANGED) ===
    { 7, "Arcane Flow", "Increases Aether Bolt velocity and capacity.", BRANCH_AETHER, { 640, 200 }, 1, 1, false, -1 },
    { 8, "Starlight Nova", "Aether Bolts explode on impact in a small area.", BRANCH_AETHER, { 640, 290 }, 1, 5, false, 7 },
    { 9, "Overcharge", "Firing at full Aether increases fire rate by +50%.", BRANCH_AETHER, { 640, 380 }, 2, 15, false, 8 },
    { 10, "Aether Beam", "Replaces single bolts with a continuous piercing laser.", BRANCH_AETHER, { 580, 470 }, 2, 25, false, 9 },
    { 11, "Flux Burst", "Dashing leaves behind an exploding decoy.", BRANCH_AETHER, { 700, 470 }, 2, 25, false, 9 },
    { 12, "APEX: OVERLOAD BEAM", "Fires a map-clearing death ray consuming all Aether.", BRANCH_AETHER, { 640, 560 }, 5, 50, false, 10 },

