    { 13, "Fleet Foot", "Increases movement speed by +15%.", BRANCH_UTILITY, { 1080, 200 }, 1, 1, false, -1 },
    { 14, "Iron Will", "Increases Maximum Health by +50 HP.", BRANCH_UTILITY, { 1080, 290 }, 1, 5, false, 13 },
    { 15, "Second Wind", "Restores 30% HP automatically when entering critical health.", BRANCH_UTILITY, { 1080, 380 }, 2, 15, false, 14 },
    { 16, "Life Siphon", "Dealing melee combo damage heals you for 5% of damage done.", BRANCH_UTILITY, { 1020, 470 }, 2, 25, false, 15 },
