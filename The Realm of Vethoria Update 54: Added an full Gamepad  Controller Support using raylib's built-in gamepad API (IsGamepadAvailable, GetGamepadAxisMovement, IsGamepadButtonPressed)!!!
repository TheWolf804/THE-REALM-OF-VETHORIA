#pragma once
#include "raylib.h"
#include "raymath.h"

enum ControllerType {
    CTRL_KEYBOARD_MOUSE = 0,
    CTRL_GAMEPAD
};

class GamepadInputManager {
public:
    int gamepadId = 0;
    float deadzone = 0.25f;
    ControllerType currentInputType = CTRL_KEYBOARD_MOUSE;

    // Movement & Aiming Inputs
    Vector2 moveInput = { 0.0f, 0.0f };
    Vector2 aimInput = { 0.0f, 0.0f };

    // Action States
    bool dodgePressed = false;
    bool attackPressed = false;
    bool interactPressed = false;
    bool inventoryTogglePressed = false;
    bool talentTogglePressed = false;

    // UI Navigation States
    bool uiUp = false;
    bool uiDown = false;
    bool uiLeft = false;
    bool uiRight = false;
    bool uiConfirm = false;
    bool uiBack = false;

    void Update() {
        bool isPadAvailable = IsGamepadAvailable(gamepadId);

        // Auto-detect last used input method
        if (isPadAvailable) {
            float lx = GetGamepadAxisMovement(gamepadId, GAMEPAD_AXIS_LEFT_X);
            float ly = GetGamepadAxisMovement(gamepadId, GAMEPAD_AXIS_LEFT_Y);
            if (fabsf(lx) > deadzone || fabsf(ly) > deadzone || GetGamepadButtonPressed() != GAMEPAD_BUTTON_UNKNOWN) {
                currentInputType = CTRL_GAMEPAD;
            }
        }

        Vector2 mouseDelta = GetMouseDelta();
        if (fabsf(mouseDelta.x) > 1.0f || fabsf(mouseDelta.y) > 1.0f || GetKeyPressed() != 0) {
            currentInputType = CTRL_KEYBOARD_MOUSE;
        }

        // Poll Gamepad Controls
        if (isPadAvailable && currentInputType == CTRL_GAMEPAD) {
            // Left Stick Movement with Deadzone Filter
            float lx = GetGamepadAxisMovement(gamepadId, GAMEPAD_AXIS_LEFT_X);
            float ly = GetGamepadAxisMovement(gamepadId, GAMEPAD_AXIS_LEFT_Y);

            moveInput.x = (fabsf(lx) > deadzone) ? lx : 0.0f;
            moveInput.y = (fabsf(ly) > deadzone) ? ly : 0.0f;
            if (Vector2Length(moveInput) > 1.0f) moveInput = Vector2Normalize(moveInput);

            // Right Stick Aiming
            float rx = GetGamepadAxisMovement(gamepadId, GAMEPAD_AXIS_RIGHT_X);
            float ry = GetGamepadAxisMovement(gamepadId, GAMEPAD_AXIS_RIGHT_Y);
            aimInput.x = (fabsf(rx) > deadzone) ? rx : 0.0f;
            aimInput.y = (fabsf(ry) > deadzone) ? ry : 0.0f;

            // Combat & Actions
            dodgePressed = IsGamepadButtonPressed(gamepadId, GAMEPAD_BUTTON_RIGHT_TRIGGER_1) || 
                           IsGamepadButtonPressed(gamepadId, GAMEPAD_BUTTON_LEFT_FACE_RIGHT); // B or RB
            attackPressed = IsGamepadButtonPressed(gamepadId, GAMEPAD_BUTTON_RIGHT_TRIGGER_2) || 
                            IsGamepadButtonPressed(gamepadId, GAMEPAD_BUTTON_LEFT_FACE_WEST);  // X or RT
            interactPressed = IsGamepadButtonPressed(gamepadId, GAMEPAD_BUTTON_LEFT_FACE_DOWN); // A
            inventoryTogglePressed = IsGamepadButtonPressed(gamepadId, GAMEPAD_BUTTON_MIDDLE_RIGHT); // Start
            talentTogglePressed = IsGamepadButtonPressed(gamepadId, GAMEPAD_BUTTON_MIDDLE_LEFT);   // Select / Back

            // UI Navigation (D-Pad or Stick Taps)
            uiUp = IsGamepadButtonPressed(gamepadId, GAMEPAD_BUTTON_LEFT_FACE_UP);
            uiDown = IsGamepadButtonPressed(gamepadId, GAMEPAD_BUTTON_LEFT_FACE_DOWN);
            uiLeft = IsGamepadButtonPressed(gamepadId, GAMEPAD_BUTTON_LEFT_FACE_LEFT);
            uiRight = IsGamepadButtonPressed(gamepadId, GAMEPAD_BUTTON_LEFT_FACE_RIGHT);

            uiConfirm = IsGamepadButtonPressed(gamepadId, GAMEPAD_BUTTON_LEFT_FACE_DOWN); // A button
            uiBack = IsGamepadButtonPressed(gamepadId, GAMEPAD_BUTTON_LEFT_FACE_RIGHT);   // B button
        } else {
            // Fallback Keyboard & Mouse Mapping
            moveInput = { 0.0f, 0.0f };
            if (IsKeyDown(KEY_W) || IsKeyDown(KEY_UP)) moveInput.y -= 1.0f;
            if (IsKeyDown(KEY_S) || IsKeyDown(KEY_DOWN)) moveInput.y += 1.0f;
            if (IsKeyDown(KEY_A) || IsKeyDown(KEY_LEFT)) moveInput.x -= 1.0f;
            if (IsKeyDown(KEY_D) || IsKeyDown(KEY_RIGHT)) moveInput.x += 1.0f;
            if (Vector2Length(moveInput) > 1.0f) moveInput = Vector2Normalize(moveInput);

            dodgePressed = IsKeyPressed(KEY_SPACE);
            attackPressed = IsMouseButtonPressed(MOUSE_BUTTON_LEFT);
            interactPressed = IsKeyPressed(KEY_E);
            inventoryTogglePressed = IsKeyPressed(KEY_I);
            talentTogglePressed = IsKeyPressed(KEY_T);

            uiUp = IsKeyPressed(KEY_W) || IsKeyPressed(KEY_UP);
            uiDown = IsKeyPressed(KEY_S) || IsKeyPressed(KEY_DOWN);
            uiLeft = IsKeyPressed(KEY_A) || IsKeyPressed(KEY_LEFT);
            uiRight = IsKeyPressed(KEY_D) || IsKeyPressed(KEY_RIGHT);
            uiConfirm = IsKeyPressed(KEY_ENTER) || IsKeyPressed(KEY_E);
            uiBack = IsKeyPressed(KEY_ESCAPE);
        }
    }

    void DrawInputTypeHUD(int screenW, int screenH) {
        const char* text = (currentInputType == CTRL_GAMEPAD) ? "INPUT: GAMEPAD (XBOX/PS)" : "INPUT: KEYBOARD & MOUSE";
        Color col = (currentInputType == CTRL_GAMEPAD) ? SKYBLUE : GREEN;
        DrawText(text, 20, screenH - 25, 10, col);
    }
#include "raylib.h"
#include "Common.h"
#include "ParticleEngine.h"
#include "Player.h"
#include "LightEngine.h"
#include "CameraManager.h"
#include "PostProcessingManager.h"
#include "DungeonGenerator.h"
#include "BossBehaviorTree.h"
#include "DialogueAndTownSystem.h"
#include "PortalManager.h"
#include "AudioManager.h"
#include "TalentTreeSystem.h"
#include "MinimapFogSystem.h"
#include "EquipmentSystem.h"
#include "CombatDepthSystem.h"
#include "BiomeAndTrapSystem.h"
#include "TownMetaProgression.h"
#include "SaveSystem.h"
#include "GamepadManager.h"

int main() {
    const int screenW = 1280, screenH = 720;
    InitWindow(screenW, screenH, "Vethoria: Full Gamepad Controller Support");
    SetTargetFPS(60);

    Player player;
    MultiStageBoss boss;
    ParticleEngine particles;
    LightEngine lighting(screenW, screenH);
    CameraManager cameraMgr(screenW, screenH);
    PostProcessingManager postFX;
    DungeonGenerator dungeon;
    DialogueAndTownManager town;
    PortalManager portals;
    AudioManager audio;
    TalentTreeManager talentTree;
    MinimapFogManager minimap;
    EquipmentManager gearMgr;
    CombatDepthManager combatMgr;
    BiomeAndTrapManager biomeMgr;
    TownMetaProgressionManager metaMgr;
    GamepadInputManager input;

    postFX.Init(screenW, screenH);
    town.InitHub();
    audio.Init();
    talentTree.Init();
    metaMgr.InitNPCs();

    player.gold = 500;
    metaMgr.bossSouls = 5;

    dungeon.Generate();
    minimap.Init(DUNGEON_COLS, DUNGEON_ROWS, TILE_SIZE);
    
    std::vector<Vector2> floorTiles;
    for (int r = 0; r < DUNGEON_ROWS; r++) {
        for (int c = 0; c < DUNGEON_COLS; c++) {
            if (dungeon.grid[r][c] == TILE_FLOOR) {
                floorTiles.push_back({ c * (float)TILE_SIZE + TILE_SIZE / 2.0f, r * (float)TILE_SIZE + TILE_SIZE / 2.0f });
            }
        }
    }
    biomeMgr.PopulateDungeonFeatures(floorTiles, BIOME_LAVA_CAVERNS);
    player.pos = { 350.0f, 300.0f };

    float saveNotificationTimer = 0.0f;
    std::string saveNotificationText = "";

    while (!WindowShouldClose()) {
        float dt = GetFrameTime();
        Vector2 mousePos = GetMousePosition();

        // 1. Poll Gamepad & Keyboard Inputs
        input.Update();

        if (saveNotificationTimer > 0.0f) saveNotificationTimer -= dt;

        // Quick Save (F5) / Quick Load (F9)
        if (IsKeyPressed(KEY_F5)) {
            std::vector<SavedUpgradeNode> savedUpgrades;
            for (const auto& npc : metaMgr.npcs) {
                for (const auto& node : npc.upgrades) {
                    SavedUpgradeNode su;
                    strncpy(su.id, node.id.c_str(), sizeof(su.id));
                    su.currentLevel = node.currentLevel;
                    savedUpgrades.push_back(su);
                }
            }
            std::vector<SavedEquipment> savedGear;
            std::vector<SavedTalentNode> savedTalents;

            if (SaveManager::SaveGame(player.gold, metaMgr.bossSouls, player.health, player.maxHealth, savedUpgrades, savedGear, savedTalents)) {
                saveNotificationText = "GAME SAVED (F5)";
                saveNotificationTimer = 2.0f;
            }
        }

        if (IsKeyPressed(KEY_F9)) {
            std::vector<SavedUpgradeNode> loadedUpgrades;
            std::vector<SavedEquipment> loadedGear;
            std::vector<SavedTalentNode> loadedTalents;

            if (SaveManager::LoadGame(player.gold, metaMgr.bossSouls, player.health, player.maxHealth, loadedUpgrades, loadedGear, loadedTalents)) {
                for (const auto& lu : loadedUpgrades) {
                    for (auto& npc : metaMgr.npcs) {
                        for (auto& node : npc.upgrades) {
                            if (node.id == lu.id) node.currentLevel = lu.currentLevel;
                        }
                    }
                }
                saveNotificationText = "GAME LOADED (F9)";
                saveNotificationTimer = 2.0f;
            }
        }

        // Gamepad D-pad Navigation in Vendor UI
        if (metaMgr.isUIOpen) {
            TownNPC* activeNPC = metaMgr.GetNPC(metaMgr.activeVendor);
            if (activeNPC && !activeNPC->upgrades.empty()) {
                if (input.uiDown) {
                    metaMgr.selectedUpgradeIndex = (metaMgr.selectedUpgradeIndex + 1) % activeNPC->upgrades.size();
                }
                if (input.uiUp) {
                    metaMgr.selectedUpgradeIndex = (metaMgr.selectedUpgradeIndex - 1 + activeNPC->upgrades.size()) % activeNPC->upgrades.size();
                }
                if (input.uiConfirm) {
                    metaMgr.PurchaseUpgrade(activeNPC->upgrades[metaMgr.selectedUpgradeIndex], player.gold);
                }
                if (input.uiBack) {
                    metaMgr.isUIOpen = false;
                }
            }
        }

        gearMgr.Update(dt, player.pos);
        talentTree.Update(mousePos);
        combatMgr.Update(dt, player.pos, player.health, boss.hp);

        // Town Interaction with Gamepad
        if (portals.currentScene == SCENE_TOWN_HUB) {
            if (input.interactPressed) {
                if (metaMgr.isUIOpen) {
                    metaMgr.isUIOpen = false;
                } else {
                    for (const auto& npc : metaMgr.npcs) {
                        if (CheckCollisionCircles(player.pos, 24.0f, npc.position, 40.0f)) {
                            metaMgr.activeVendor = npc.type;
                            metaMgr.selectedUpgradeIndex = 0;
                            metaMgr.isUIOpen = true;
                            break;
                        }
                    }
                }
            }
        }

        bool menuOpen = talentTree.isOpen || gearMgr.isInventoryOpen || metaMgr.isUIOpen;

        if (combatMgr.hitStopTimer <= 0.0f && !menuOpen) {
            portals.Update(dt, player.pos, dungeon, particles);
            audio.Update(dt);

            // Apply Gamepad Stick Locomotion
            if (Vector2Length(input.moveInput) > 0.0f) {
                player.pos.x += input.moveInput.x * 200.0f * dt;
                player.pos.y += input.moveInput.y * 200.0f * dt;
            }

            if (portals.currentScene == SCENE_DUNGEON) {
                biomeMgr.Update(dt, player.pos, player.health);
                player.Update(dt, particles);
                minimap.Update(player.pos);

                if (boss.hp > 0.0f) {
                    boss.Update(dt, player.pos, player.health, particles);
                }
            } else {
                town.Update(player.pos, player.gold);
                player.Update(dt, particles);
            }

            particles.Update(dt);
            cameraMgr.Update(player.pos, boss.pos, portals.currentScene == SCENE_DUNGEON && boss.hp > 0, dt);
        }

        // Render Frame Pass
        postFX.BeginRenderPass();
            cameraMgr.BeginMode();
                if (portals.currentScene == SCENE_TOWN_HUB) {
                    town.DrawHubWorld(player.pos);
                    metaMgr.DrawWorldNPCs(player.pos);
                } else {
                    dungeon.Draw();
                    biomeMgr.DrawTrapsAndShrines();
                    combatMgr.DrawTelegraphs();
                    boss.Draw();
                }

                gearMgr.DrawWorldLootBeams();
                portals.DrawPortalWorldSpace(player.pos);
                player.Draw();
                particles.Draw();

                lighting.BeginLightPass();
                lighting.DrawLight(player.pos, 260.0f, ORANGE, 0.85f);
                lighting.EndLightPass(portals.currentScene == SCENE_TOWN_HUB ? GetColor(0x181822FF) : biomeMgr.GetBiomeTheme(biomeMgr.currentBiome).ambientLightColor);
            cameraMgr.EndMode();
        
        postFX.EndRenderPassAndApplyFX(dt, player.health, player.maxHealth, screenW, screenH);

        // HUD & Overlays
        player.DrawHUD();
        combatMgr.DrawCombatHUD(screenW);
        input.DrawInputTypeHUD(screenW, screenH);
        
        if (portals.currentScene == SCENE_DUNGEON) {
            biomeMgr.DrawBuffHUD();
            minimap.DrawMinimapHUD(screenW, dungeon, player.pos, boss.pos, boss.hp > 0, portals.dungeonReturnPortal.pos, portals.dungeonReturnPortal.active);
        }

        talentTree.Draw(screenW, screenH, mousePos);
        gearMgr.DrawEquipmentUI(screenW, screenH, mousePos);
        metaMgr.DrawVendorUI(screenW, screenH, player.gold, mousePos);

        DrawText("F5: Quick Save  |  F9: Quick Load", screenW - 250, 15, 11, RAYWHITE);

        if (saveNotificationTimer > 0.0f) {
            DrawRectangle(screenW / 2 - 160, screenH - 60, 320, 30, ColorAlpha(BLACK, 0.85f));
            DrawRectangleLines(screenW / 2 - 160, screenH - 60, 320, 30, GREEN);
            DrawText(saveNotificationText.c_str(), screenW / 2 - MeasureText(saveNotificationText.c_str(), 11) / 2, screenH - 50, 11, GREEN);
        }

        EndDrawing();
    }

    audio.Unload();
    postFX.Unload();
    CloseWindow();
    return 0;
}
};
