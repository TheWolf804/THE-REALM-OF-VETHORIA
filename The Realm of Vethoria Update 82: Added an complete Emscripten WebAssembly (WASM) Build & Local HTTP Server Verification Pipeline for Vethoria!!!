#!/bin/bash
set -e

echo "=================================================="
echo "      Vethoria Emscripten WASM Build & Server     "
echo "=================================================="

# 1. Verify Emscripten toolchain is active
if ! command -v emcc &> /dev/null; then
    echo "[Error] 'emcc' not found! Please activate your Emscripten SDK first:"
    echo "        source /path/to/emsdk/emsdk_env.sh"
    exit 1
fi

# 2. Configure and compile WebAssembly target
echo "[1/3] Configuring CMake with Emscripten..."
mkdir -p build_wasm
cd build_wasm
emcmake cmake .. -DCMAKE_BUILD_TYPE=Release

echo "[2/3] Compiling C++17 to WebAssembly (.wasm / .js / .html)..."
emmake make -j$(nproc)

# 3. Copy assets into build_wasm if needed
if [ -d "../assets" ]; then
    cp -r ../assets ./
fi

echo "[3/3] Build successful! Starting local HTTP server..."
echo "      Open your browser to: http://localhost:8080/vethoria.html"
echo "      Press Ctrl+C to stop the server."

# Launch local web server (uses Python 3 built-in HTTP server with WASM MIME support)
python3 -m http.server 8080
