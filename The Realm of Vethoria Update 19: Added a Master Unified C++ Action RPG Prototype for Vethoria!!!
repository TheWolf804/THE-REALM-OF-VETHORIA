// =======================================================================================
// 1. GAME STATES & ENUMS
// =======================================================================================
enum GameState { STATE_MENU, STATE_SETTINGS, STATE_GAMEPLAY };
enum UpscaleMode { UPSCALE_OFF, UPSCALE_MATCH, UPSCALE_OVERLEVEL };
enum Rarity { RARITY_COMMON, RARITY_UNCOMMON, RARITY_RARE, RARITY_EPIC, RARITY_LEGENDARY };
enum ItemType { ITEM_WEAPON, ITEM_ARMOR, ITEM_POTION };
enum BossState { BOSS_IDLE, BOSS_CHASE, BOSS_TELEGRAPH, BOSS_ATTACK, BOSS_COOLDOWN };
enum TileType { TILE_FLOOR = 0, TILE_WALL = 1, TILE_DOOR = 2 };

// =======================================================================================
// 2. PARTICLE SYSTEM ENGINE
// =======================================================================================
struct Particle {
    Vector2 pos, vel;
    Color col;
    float size, alpha, maxLife, currentLife;
    bool active = false;
};

class ParticleEngine {
    static const int MAX_P = 200;
    Particle particles[MAX_P];
public:
    ParticleEngine() { for (int i = 0; i < MAX_P; i++) particles[i].active = false; }

    void Emit(Vector2 pos, Color col, int count, float minSpeed, float maxSpeed) {
        int spawned = 0;
        for (int i = 0; i < MAX_P && spawned < count; i++) {
            if (!particles[i].active) {
                particles[i].active = true;
                particles[i].pos = pos;
                float angle = (float)GetRandomValue(0, 360) * DEG2RAD;
                float speed = (float)GetRandomValue((int)minSpeed, (int)maxSpeed);
                particles[i].vel = { cosf(angle) * speed, sinf(angle) * speed };
                particles[i].col = col;
                particles[i].size = (float)GetRandomValue(3, 6);
                particles[i].maxLife = (float)GetRandomValue(15, 40) / 100.0f;
                particles[i].currentLife = particles[i].maxLife;
                particles[i].alpha = 1.0f;
                spawned++;
            }
        }
    }

    void Update(float dt) {
        for (int i = 0; i < MAX_P; i++) {
            if (particles[i].active) {
                particles[i].currentLife -= dt;
                if (particles[i].currentLife <= 0.0f) { particles[i].active = false; continue; }
                particles[i].pos = Vector2Add(particles[i].pos, Vector2Scale(particles[i].vel, dt));
                particles[i].vel = Vector2Scale(particles[i].vel, 0.92f);
                particles[i].alpha = particles[i].currentLife / particles[i].maxLife;
            }
        }
    }

    void Draw() {
        for (int i = 0; i < MAX_P; i++) {
            if (particles[i].active) {
                Color c = particles[i].col;
                c.a = (unsigned char)(particles[i].alpha * 255);
                DrawCircleV(particles[i].pos, particles[i].size * particles[i].alpha, c);
            }
        }
    }
};

// =======================================================================================
// 3. ITEMS & INVENTORY ENGINE
// =======================================================================================
struct Item {
    std::string name;
    ItemType type;
    Rarity rarity;
    int bonusAttack, bonusDefense, bonusHealth;
    Color color;
};

Color GetRarityColor(Rarity r) {
    if (r == RARITY_LEGENDARY) return GOLD;
    if (r == RARITY_EPIC) return PURPLE;
    if (r == RARITY_RARE) return SKYBLUE;
    if (r == RARITY_UNCOMMON) return GREEN;
    return LIGHTGRAY;
}

Item GenerateRandomLoot() {
    int roll = GetRandomValue(1, 100);
    Rarity rarity = RARITY_COMMON;
    if (roll > 94) rarity = RARITY_LEGENDARY;
    else if (roll > 78) rarity = RARITY_EPIC;
    else if (roll > 55) rarity = RARITY_RARE;
    else if (roll > 30) rarity = RARITY_UNCOMMON;

    int typeRoll = GetRandomValue(0, 2);
    Item item; item.rarity = rarity; item.color = GetRarityColor(rarity);
    int scale = (int)rarity + 1;

    if (typeRoll == 0) {
        item.type = ITEM_WEAPON; item.bonusAttack = scale * GetRandomValue(6, 12); item.bonusDefense = 0; item.bonusHealth = 0;
        const char* names[] = { "Blade", "Warhammer", "Greatsword", "Staff" };
        item.name = TextFormat("Tier-%d %s", scale, names[GetRandomValue(0, 3)]);
    } else if (typeRoll == 1) {
        item.type = ITEM_ARMOR; item.bonusAttack = 0; item.bonusDefense = scale * GetRandomValue(4, 7); item.bonusHealth = scale * 20;
        const char* names[] = { "Vest", "Cuirass", "Plate", "Aegis" };
        item.name = TextFormat("Tier-%d %s", scale, names[GetRandomValue(0, 3)]);
    } else {
        item.type = ITEM_POTION; item.bonusAttack = 0; item.bonusDefense = 0; item.bonusHealth = scale * 30;
        item.name = "Health Elixir"; item.color = RED;
    }
    return item;
}

// =======================================================================================
// 4. PLAYER ARCHETYPE & STAT RECALCULATION
// =======================================================================================
struct PlayerState {
    Vector2 pos = { 200.0f, 360.0f };
    int level = 8;
    float health = 150.0f;
    int baseAttack = 20, baseDefense = 5, baseMaxHealth = 150;
    int totalAttack = 20, totalDefense = 5, totalMaxHealth = 150;

    Item weaponSlot; bool hasWeapon = false;
    Item armorSlot;  bool hasArmor = false;
    Item inventory[16]; bool slotOccupied[16] = { false };

    void RecalculateStats() {
        totalAttack = baseAttack + (hasWeapon ? weaponSlot.bonusAttack : 0);
        totalDefense = baseDefense + (hasArmor ? armorSlot.bonusDefense : 0);
        totalMaxHealth = baseMaxHealth + (hasArmor ? armorSlot.bonusHealth : 0);
        if (health > totalMaxHealth) health = (float)totalMaxHealth;
    }
};

// =======================================================================================
// 5. MAP & TRANSITION ENGINE
// =======================================================================================
