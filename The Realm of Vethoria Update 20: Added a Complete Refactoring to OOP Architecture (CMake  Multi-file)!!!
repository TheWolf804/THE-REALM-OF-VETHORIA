int main() {
    const int screenW = 1280, screenH = 720;
    InitWindow(screenW, screenH, "Vethoria: Modular OOP Engine");
    SetTargetFPS(60);

    Player player;
    BossManager boss;
    WorldManager world;
    ParticleEngine particles;

    while (!WindowShouldClose()) {
        float dt = GetFrameTime();

        // Engine Updates
        player.Update(dt, false);
        boss.Update(dt, player.pos, (float)player.totalDefense, player.health, particles);
        particles.Update(dt);

        // Render Frame
        BeginDrawing();
        ClearBackground(BLACK);

        world.DrawCurrentRoom();
        boss.Draw();
        player.Draw();
        particles.Draw();
        player.DrawInventoryUI();

        DrawText("[WASD] Move | [E] Toggle Inventory", 20, screenH - 22, 13, LIGHTGRAY);

        EndDrawing();
    }

    CloseWindow();
    return 0;
}

