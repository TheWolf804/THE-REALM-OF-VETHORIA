struct Particle {
    Vector2 pos, vel;
    Color col;
    float size, alpha, maxLife, currentLife;
    bool active = false;
};

class ParticleEngine {
private:
    static const int MAX_P = 200;
    Particle particles[MAX_P];
public:
    ParticleEngine();
    void Emit(Vector2 pos, Color col, int count, float minSpeed, float maxSpeed);
    void Update(float dt);
    void Draw();
};
#include "ParticleEngine.h"
#include <cmath>

ParticleEngine::ParticleEngine() {
    for (int i = 0; i < MAX_P; i++) particles[i].active = false;
}

void ParticleEngine::Emit(Vector2 pos, Color col, int count, float minSpeed, float maxSpeed) {
    int spawned = 0;
    for (int i = 0; i < MAX_P && spawned < count; i++) {
        if (!particles[i].active) {
            particles[i].active = true;
            particles[i].pos = pos;
            float angle = (float)GetRandomValue(0, 360) * DEG2RAD;
            float speed = (float)GetRandomValue((int)minSpeed, (int)maxSpeed);
            particles[i].vel = { cosf(angle) * speed, sinf(angle) * speed };
            particles[i].col = col;
            particles[i].size = (float)GetRandomValue(3, 6);
            particles[i].maxLife = (float)GetRandomValue(15, 40) / 100.0f;
            particles[i].currentLife = particles[i].maxLife;
            particles[i].alpha = 1.0f;
            spawned++;
        }
    }
}

void ParticleEngine::Update(float dt) {
    for (int i = 0; i < MAX_P; i++) {
        if (particles[i].active) {
            particles[i].currentLife -= dt;
            if (particles[i].currentLife <= 0.0f) { particles[i].active = false; continue; }
            particles[i].pos = Vector2Add(particles[i].pos, Vector2Scale(particles[i].vel, dt));
            particles[i].vel = Vector2Scale(particles[i].vel, 0.92f);
            particles[i].alpha = particles[i].currentLife / particles[i].maxLife;
        }
    }
}

void ParticleEngine::Draw() {
    for (int i = 0; i < MAX_P; i++) {
        if (particles[i].active) {
            Color c = particles[i].col;
            c.a = (unsigned char)(particles[i].alpha * 255);
            DrawCircleV(particles[i].pos, particles[i].size * particles[i].alpha, c);
        }
    }
}
