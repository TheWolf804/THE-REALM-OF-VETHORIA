enum BossState { BOSS_IDLE, BOSS_CHASE, BOSS_TELEGRAPH, BOSS_ATTACK, BOSS_COOLDOWN };

class BossManager {
public:
    BossState state = BOSS_IDLE;
    Vector2 pos = { 850.0f, 360.0f };
    Vector2 attackTarget = { 0, 0 };
    float maxHP = 350.0f, hp = 350.0f, dmg = 25.0f;
    float timer = 0.0f, telegraphProgress = 0.0f;
    bool enraged = false;

    void Update(float dt, Vector2 playerPos, float playerDef, float& playerHP, ParticleEngine& particles);
    void Draw();
};
#include "BossManager.h"

void BossManager::Update(float dt, Vector2 playerPos, float playerDef, float& playerHP, ParticleEngine& particles) {
    if (hp <= 0) return;
    
    timer += dt;
    if (!enraged && hp <= (maxHP * 0.5f)) { enraged = true; dmg = 40.0f; }

    switch (state) {
        case BOSS_IDLE: 
            if (timer >= 0.5f) { state = BOSS_CHASE; timer = 0.0f; } 
            break;
        case BOSS_CHASE: {
            Vector2 dir = Vector2Normalize(Vector2Subtract(playerPos, pos));
            pos = Vector2Add(pos, Vector2Scale(dir, (enraged ? 170.0f : 110.0f) * dt));
            if (Vector2Distance(pos, playerPos) < 160.0f || timer > 3.0f) {
                state = BOSS_TELEGRAPH; timer = 0.0f; attackTarget = playerPos;
            }
        } break;
        case BOSS_TELEGRAPH: {
            telegraphProgress = timer / (enraged ? 0.6f : 1.2f);
            if (timer >= (enraged ? 0.6f : 1.2f)) { state = BOSS_ATTACK; timer = 0.0f; }
        } break;
        case BOSS_ATTACK: {
            particles.Emit(attackTarget, RED, 30, 150.0f, 400.0f);
            if (Vector2Distance(playerPos, attackTarget) <= 120.0f) {
                float finalDmg = (dmg - playerDef > 5.0f) ? dmg - playerDef : 5.0f;
                playerHP -= finalDmg;
            }
            state = BOSS_COOLDOWN; timer = 0.0f;
        } break;
        case BOSS_COOLDOWN: 
            if (timer >= 1.0f) { state = BOSS_CHASE; timer = 0.0f; } 
            break;
    }
}

void BossManager::Draw() {
    if (hp <= 0) return;
    if (state == BOSS_TELEGRAPH) {
        DrawCircleV(attackTarget, 120.0f * telegraphProgress, Fade(RED, 0.35f));
        DrawCircleLines(attackTarget.x, attackTarget.y, 120.0f, RED);
    }
    DrawCircleV(pos, 35.0f, enraged ? PURPLE : MAROON);
    DrawText(enraged ? "VOID TITAN [ENRAGED]" : "VOID TITAN", pos.x - 55, pos.y - 55, 12, RED);
    DrawRectangle(pos.x - 40, pos.y + 42, 80, 6, RED);
    DrawRectangle(pos.x - 40, pos.y + 42, (hp / maxHP) * 80, 6, GREEN);
}
