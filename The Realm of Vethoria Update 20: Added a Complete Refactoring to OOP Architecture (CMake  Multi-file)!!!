void WorldManager::DrawCurrentRoom() {
    Color wallCol = (currentRoom == 0) ? GetColor(0x2A2A3CFF) : GetColor(0x243424FF);
    Color floorCol = (currentRoom == 0) ? GetColor(0x1A1A24FF) : GetColor(0x141C14FF);

    for (int r = 0; r < MAP_ROWS; r++) {
        for (int c = 0; c < MAP_COLS; c++) {
            Rectangle tileRec = { (float)c * TILE_SIZE, (float)r * TILE_SIZE, (float)TILE_SIZE, (float)TILE_SIZE };
            int type = roomMaps[currentRoom][r][c];
            if (type == 1) DrawRectangleRec(tileRec, wallCol);
            else if (type == 0) DrawRectangleRec(tileRec, floorCol);
            else if (type == 2) DrawRectangleRec(tileRec, GREEN);
            DrawRectangleLinesEx(tileRec, 1, GetColor(0x181824FF));
        }
    }
}
