#!/usr/bin/env bash
set -e

echo "=== Building Vethoria for WebAssembly (WASM) ==="

# 1. Ensure EMSDK environment is set up (adjust path to your emsdk installation if needed)
if [ -z "$EMSDK" ]; then
    echo "Error: EMSDK environment variable not found. Source emsdk_env.sh first!"
    exit 1
fi

# 2. Setup WASM Build Directory
BUILD_DIR="build_wasm"
mkdir -p $BUILD_DIR
cd $BUILD_DIR

# 3. Configure CMake with Emscripten Toolchain
emcmake cmake .. -DCMAKE_BUILD_TYPE=Release

# 4. Compile Target
emmake make -j$(nproc)

echo "=== Build Complete! Target generated in $BUILD_DIR/Vethoria.html ==="
echo "=== Starting Local HTTP Server on Port 8000... ==="

# 5. Serve WebAssembly Bundle locally
python3 -m http.server 8000

endif()
