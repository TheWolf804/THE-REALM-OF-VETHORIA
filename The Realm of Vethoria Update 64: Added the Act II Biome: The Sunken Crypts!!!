#pragma once
#include "raylib.h"
#include "raymath.h"
#include "ParticleEngine.h"
#include <vector>
#include <string>

enum UndeadType {
    UNDEAD_CRYPT_STALKER = 0,
    UNDEAD_NECROTIC_ABOMINATION
};

struct UndeadEnemy {
    int id;
    Vector2 pos;
    float hp;
    float maxHp;
    float radius;
    float speed;
    UndeadType type;
    Color color;
};

struct PoisonSludgePool {
    Vector2 pos;
    float radius;
    float pulseTimer;
};

class Act2SunkenCryptsManager {
public:
    std::vector<PoisonSludgePool> sludgePools;
    std::vector<UndeadEnemy> undeadMobs;

    // Act II Boss: Malgor, Lord of Decay
    std::string bossName = "Malgor, Lord of Decay";
    Vector2 bossPos;
    float bossHp = 1800.0f;
    float bossMaxHp = 1800.0f;
    float bossRadius = 40.0f;
    float bossAttackTimer = 0.0f;
    bool bossActive = false;

    // Player Status Effects
    float poisonTimer = 0.0f;
    float poisonTickTimer = 0.0f;

    void PopulateSunkenCrypts(const std::vector<Vector2>& floorTiles, Vector2 bossSpawnTile) {
        sludgePools.clear();
        undeadMobs.clear();

        // 1. Spawn Poison Sludge Hazard Pools
        int numPools = (int)floorTiles.size() / 15;
        for (int i = 0; i < numPools; i++) {
            int idx = GetRandomValue(0, (int)floorTiles.size() - 1);
            sludgePools.push_back({ floorTiles[idx], (float)GetRandomValue(35, 65), (float)GetRandomValue(0, 100) * 0.1f });
        }

        // 2. Spawn Undead Enemy Mobs
        int numMobs = (int)floorTiles.size() / 12;
        for (int i = 0; i < numMobs; i++) {
            int idx = GetRandomValue(0, (int)floorTiles.size() - 1);
            bool isAbom = (GetRandomValue(0, 100) < 30); // 30% chance for heavy Abomination

            UndeadEnemy mob;
            mob.id = GetRandomValue(2000, 8999);
            mob.pos = floorTiles[idx];
            mob.type = isAbom ? UNDEAD_NECROTIC_ABOMINATION : UNDEAD_CRYPT_STALKER;
            mob.hp = isAbom ? 240.0f : 110.0f;
            mob.maxHp = mob.hp;
            mob.radius = isAbom ? 24.0f : 16.0f;
            mob.speed = isAbom ? 65.0f : 130.0f;
            mob.color = isAbom ? DARKGREEN : LIME;
            undeadMobs.push_back(mob);
        }

        // 3. Initialize Malgor
        bossPos = bossSpawnTile;
        bossHp = 1800.0f;
        bossMaxHp = 1800.0f;
        bossActive = true;
        bossAttackTimer = 0.0f;
    }

    void Update(float dt, Vector2 playerPos, float& playerHp, ParticleEngine& particles) {
        // 1. Poison Sludge Pool Collision Check
        for (auto& pool : sludgePools) {
            pool.pulseTimer += dt * 3.0f;
            if (CheckCollisionCircles(playerPos, 14.0f, pool.pos, pool.radius)) {
                poisonTimer = 3.0f; // Inflict 3-second poison DoT
            }
        }

        // Process Poison DoT Ticks on Player
        if (poisonTimer > 0.0f) {
            poisonTimer -= dt;
            poisonTickTimer += dt;
            if (poisonTickTimer >= 0.5f) { // Damage tick every 0.5s
                playerHp -= 6.0f;
                poisonTickTimer = 0.0f;
                particles.SpawnParticle(playerPos, { (float)GetRandomValue(-15, 15), -35.0f }, GREEN, 0.35f, 3.0f);
            }
        }

        // 2. Update Undead Mobs
        for (auto it = undeadMobs.begin(); it != undeadMobs.end();) {
            Vector2 toPlayer = Vector2Subtract(playerPos, it->pos);
            float dist = Vector2Length(toPlayer);

            if (dist < 320.0f && dist > 0.1f) {
                Vector2 moveDir = Vector2Scale(Vector2Normalize(toPlayer), it->speed * dt);
                it->pos = Vector2Add(it->pos, moveDir);

                // Melee Strike
                if (dist < (it->radius + 14.0f)) {
                    playerHp -= (it->type == UNDEAD_NECROTIC_ABOMINATION) ? 18.0f * dt : 10.0f * dt;
                }
            }

            if (it->hp <= 0.0f) {
                // Death Poison Burst
                for (int p = 0; p < 12; p++) {
                    float angle = (float)p * (2.0f * PI / 12.0f);
                    particles.SpawnParticle(it->pos, { cosf(angle) * 80.0f, sinf(angle) * 80.0f }, LIME, 0.4f, 4.0f);
                }
                it = undeadMobs.erase(it);
            } else {
                ++it;
            }
        }

        // 3. Update Boss: Malgor, Lord of Decay
        if (bossActive && bossHp > 0.0f) {
            bossAttackTimer += dt;

            // Malgor Poison Shockwave & Minion Summon Loop
            if (bossAttackTimer >= 3.0f) {
                bossAttackTimer = 0.0f;

                // Fire Ring of Poison Missiles
                for (int i = 0; i < 24; i++) {
                    float angle = (float)i * (2.0f * PI / 24.0f);
                    Vector2 dir = { cosf(angle), sinf(angle) };
                    particles.SpawnParticle(bossPos, Vector2Scale(dir, 180.0f), GREEN, 0.6f, 6.0f);
                }

                // Summon Crypt Stalker Minion if HP below 50%
                if (bossHp < bossMaxHp * 0.5f && undeadMobs.size() < 15) {
                    UndeadEnemy minion;
                    minion.id = GetRandomValue(9000, 9999);
                    minion.pos = Vector2Add(bossPos, { (float)GetRandomValue(-40, 40), (float)GetRandomValue(-40, 40) });
                    minion.type = UNDEAD_CRYPT_STALKER;
                    minion.hp = 80.0f;
                    minion.maxHp = 80.0f;
                    minion.radius = 16.0f;
                    minion.speed = 140.0f;
                    minion.color = LIME;
                    undeadMobs.push_back(minion);
                }
            }
        }
    }

    void ApplyDamageToUndeadAndBoss(Vector2 hitCenter, float hitRadius, float damage, Vector2 attackOrigin, ParticleEngine& particles) {
        // Hit Undead Mobs
        for (auto& mob : undeadMobs) {
            if (CheckCollisionCircles(hitCenter, hitRadius, mob.pos, mob.radius)) {
                mob.hp -= damage;
                Vector2 kbDir = Vector2Normalize(Vector2Subtract(mob.pos, attackOrigin));
                mob.pos = Vector2Add(mob.pos, Vector2Scale(kbDir, 12.0f));

                for (int i = 0; i < 5; i++) {
                    particles.SpawnParticle(mob.pos, { (float)GetRandomValue(-50, 50), (float)GetRandomValue(-50, 50) }, LIME, 0.2f, 3.0f);
                }
            }
        }

        // Hit Malgor
        if (bossActive && bossHp > 0.0f) {
            if (CheckCollisionCircles(hitCenter, hitRadius, bossPos, bossRadius)) {
                bossHp -= damage;
                for (int i = 0; i < 8; i++) {
                    particles.SpawnParticle(bossPos, { (float)GetRandomValue(-80, 80), (float)GetRandomValue(-80, 80) }, GREEN, 0.25f, 4.0f);
                }
            }
        }
    }

    void DrawInWorldSpace() {
        // Render Poison Sludge Hazard Pools
        for (const auto& pool : sludgePools) {
            float pulse = sinf(pool.pulseTimer) * 4.0f;
            DrawCircleV(pool.pos, pool.radius + pulse, ColorAlpha(DARKGREEN, 0.45f));
            DrawCircleLines((int)pool.pos.x, (int)pool.pos.y, pool.radius + pulse, LIME);
        }

        // Render Undead Mobs
        for (const auto& mob : undeadMobs) {
            DrawCircleV(mob.pos, mob.radius, mob.color);
            DrawCircleLines((int)mob.pos.x, (int)mob.pos.y, mob.radius + 2.0f, GREEN);

            // HP Bar
            float ratio = mob.hp / mob.maxHp;
            DrawRectangle((int)mob.pos.x - 14, (int)mob.pos.y - (int)mob.radius - 8, 28, 4, BLACK);
            DrawRectangle((int)mob.pos.x - 14, (int)mob.pos.y - (int)mob.radius - 8, (int)(28.0f * ratio), 4, GREEN);
        }

        // Render Malgor, Lord of Decay
        if (bossActive && bossHp > 0.0f) {
            DrawCircleV(bossPos, bossRadius, GetColor(0x113B11FF));
            DrawCircleLines((int)bossPos.x, (int)bossPos.y, bossRadius + 4.0f, GREEN);

            float pulse = sinf(GetTime() * 5.0f) * 6.0f;
            DrawCircleLines((int)bossPos.x, (int)bossPos.y, bossRadius + 12.0f + pulse, ColorAlpha(LIME, 0.7f));
        }
    }

    void DrawAct2HUD(int screenW) {
        // Poison Status Debuff Overlay Icon
        if (poisonTimer > 0.0f) {
            DrawRectangle(20, 115, 120, 24, ColorAlpha(BLACK, 0.8f));
            DrawRectangleLines(20, 115, 120, 24, GREEN);
            DrawText(TextFormat("POISONED! (%.1fs)", poisonTimer), 28, 121, 10, GREEN);
        }

        // Malgor Boss Health Bar
        if (bossActive && bossHp > 0.0f) {
            int barW = 500, barH = 22;
            int barX = (screenW - barW) / 2;
            int barY = 55;

            DrawRectangle(barX, barY, barW, barH, ColorAlpha(BLACK, 0.85f));
            float hpRatio = bossHp / bossMaxHp;
            DrawRectangle(barX, barY, (int)(barW * hpRatio), barH, DARKGREEN);
            DrawRectangleLines(barX, barY, barW, barH, GREEN);

            DrawText(bossName.c_str(), barX + 10, barY - 18, 14, GREEN);
            DrawText("ACT II BOSS", barX + barW - 90, barY - 16, 11, LIME);
        }
    }
