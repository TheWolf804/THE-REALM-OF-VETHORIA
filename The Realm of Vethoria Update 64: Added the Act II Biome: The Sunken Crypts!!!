int main() {
    const int screenW = 1280, screenH = 720;
    InitWindow(screenW, screenH, "Vethoria: Act II - Sunken Crypts & Malgor");
    SetTargetFPS(60);

    Player player;
    ParticleEngine particles;
    LightEngine lighting(screenW, screenH);
    CameraManager cameraMgr(screenW, screenH);
    PostProcessingManager postFX;
    DungeonGenerator dungeon;
    DialogueAndTownManager town;
    PortalManager portals;
    AudioManager audio;
    TalentTreeManager talentTree;
    MinimapFogManager minimap;
    EquipmentManager gearMgr;
    CombatDepthManager combatMgr;
    BiomeAndTrapManager biomeMgr;
    TownMetaProgressionManager metaMgr;
    GamepadInputManager input;
    ClassAndComboManager classMgr;
    EliteAndMinibossSystem eliteMgr;
    CombatUIAndTooltipManager combatUIMgr;
    MultiFloorManager floorMgr;
    AudioSynthesizerManager synthAudio;
    WasmWebManager wasmWeb;
    QuestAndBountyManager questMgr;
    ProceduralBossAndMutatorManager proceduralBossMgr;
    SetAndGemCraftingManager setGemMgr;
    Act2SunkenCryptsManager act2Crypts;

    postFX.Init(screenW, screenH);
    town.InitHub();
    audio.Init();
    talentTree.Init();
    metaMgr.InitNPCs();
    classMgr.Init();
    synthAudio.Init();
    wasmWeb.Init();
    questMgr.InitQuests();
    setGemMgr.InitSetProfiles();

    player.gold = 500;
    metaMgr.bossSouls = 5;

    auto GenerateFloorContent = [&]() {
        dungeon.Generate();
        minimap.Init(DUNGEON_COLS, DUNGEON_ROWS, TILE_SIZE);

        std::vector<Vector2> floorTiles;
        for (int r = 0; r < DUNGEON_ROWS; r++) {
            for (int c = 0; c < DUNGEON_COLS; c++) {
                if (dungeon.grid[r][c] == TILE_FLOOR) {
                    floorTiles.push_back({ c * (float)TILE_SIZE + TILE_SIZE / 2.0f, r * (float)TILE_SIZE + TILE_SIZE / 2.0f });
                }
            }
        }

        if (floorTiles.size() > 50) {
            floorMgr.SpawnFloorExits(floorTiles[15], floorTiles[45], floorMgr.currentFloor + 3);
            player.pos = floorTiles[0];
            act2Crypts.PopulateSunkenCrypts(floorTiles, floorTiles[30]);
        }
    };

    GenerateFloorContent();

    while (!WindowShouldClose()) {
        float dt = GetFrameTime();
        Vector2 mousePos = GetMousePosition();

        input.Update();
        combatUIMgr.Update(dt);
        synthAudio.Update(player.pos);

        if (IsKeyPressed(KEY_C)) {
            classMgr.isClassSelectionOpen = !classMgr.isClassSelectionOpen;
        }

        ClassProfile prof = classMgr.GetCurrentProfile();
        player.maxHealth = prof.maxHealth;

        classMgr.Update(dt, player.pos, particles);

        if (!classMgr.isClassSelectionOpen && !metaMgr.isUIOpen && !talentTree.isOpen && !questMgr.isDialogueOpen && !setGemMgr.isCraftingUIOpen) {
            if (input.attackPressed) {
                Vector2 aimDir = (input.currentInputType == CTRL_GAMEPAD) ? input.aimInput : Vector2Subtract(GetScreenToWorld2D(mousePos, cameraMgr.camera), player.pos);
                classMgr.TriggerAttack(player.pos, aimDir);
                synthAudio.PlaySound2D(SFX_SWORD_SWING, 0.6f);

                if (classMgr.activeHitbox.active) {
                    float totalDmg = prof.baseDamage * classMgr.activeHitbox.damageMultiplier;
                    bool isCrit = ((float)GetRandomValue(0, 100) / 100.0f) < prof.critChance;
                    if (isCrit) {
                        totalDmg *= 1.75f;
                        synthAudio.PlaySound2D(SFX_CRITICAL_HIT, 0.9f);
                    }

                    combatUIMgr.SpawnDamageText(classMgr.activeHitbox.center, totalDmg, isCrit ? DAMAGE_CRIT : DAMAGE_NORMAL);
                    act2Crypts.ApplyDamageToUndeadAndBoss(classMgr.activeHitbox.center, classMgr.activeHitbox.radius, totalDmg, player.pos, particles);
                }
            }

            if (IsKeyPressed(KEY_Q) || IsGamepadButtonPressed(0, GAMEPAD_BUTTON_LEFT_FACE_WEST)) {
                classMgr.TriggerActiveAbility(player.pos, particles);
                synthAudio.PlaySound2D(SFX_STATUS_POP, 0.8f);
            }
        }

        gearMgr.Update(dt, player.pos);
        talentTree.Update(mousePos);
        combatMgr.Update(dt, player.pos, player.health, act2Crypts.bossHp);

        bool shouldRegenFloor = false;
        if (portals.currentScene == SCENE_DUNGEON) {
            floorMgr.Update(dt, player.pos, shouldRegenFloor);
            if (shouldRegenFloor) {
                GenerateFloorContent();
                floorMgr.isTransitioning = false;
            }
        }

        if (portals.currentScene == SCENE_TOWN_HUB) {
            metaMgr.CheckNPCInteractions(player.pos);
        }

        bool menuOpen = talentTree.isOpen || gearMgr.isInventoryOpen || metaMgr.isUIOpen || classMgr.isClassSelectionOpen || questMgr.isDialogueOpen || setGemMgr.isCraftingUIOpen;

        if (combatMgr.hitStopTimer <= 0.0f && !menuOpen && !floorMgr.isTransitioning) {
            portals.Update(dt, player.pos, dungeon, particles);
            audio.Update(dt);

            if (Vector2Length(input.moveInput) > 0.0f) {
                player.pos.x += input.moveInput.x * prof.moveSpeed * dt;
                player.pos.y += input.moveInput.y * prof.moveSpeed * dt;
            }

            if (portals.currentScene == SCENE_DUNGEON) {
                act2Crypts.Update(dt, player.pos, player.health, particles); // Act II Sunken Crypts Logic
                player.Update(dt, particles);
                minimap.Update(player.pos);
            } else {
                town.Update(player.pos, player.gold);
                player.Update(dt, particles);
            }

            particles.Update(dt);
            cameraMgr.Update(player.pos, act2Crypts.bossPos, portals.currentScene == SCENE_DUNGEON && act2Crypts.bossHp > 0, dt);
        }

        // Render Frame Pass
        postFX.BeginRenderPass();
            cameraMgr.BeginMode();
                if (portals.currentScene == SCENE_TOWN_HUB) {
                    town.DrawHubWorld(player.pos);
                    metaMgr.DrawWorldNPCs(player.pos);
                } else {
                    dungeon.Draw();
                    floorMgr.DrawWorldSpace();
                    act2Crypts.DrawInWorldSpace(); // Draw Sludge Hazards, Undead Mobs & Malgor
                    combatMgr.DrawTelegraphs();
                }

                classMgr.DrawAttackVisuals(player.pos);
                gearMgr.DrawWorldLootBeams();
                portals.DrawPortalWorldSpace(player.pos);
                player.Draw();
                particles.Draw();

                combatUIMgr.DrawFloatingTexts(cameraMgr.camera);

                lighting.BeginLightPass();
                lighting.DrawLight(player.pos, 260.0f, prof.themeColor, 0.85f);
                // Dark Emerald Ambient Lighting for Sunken Crypts
                lighting.EndLightPass(portals.currentScene == SCENE_TOWN_HUB ? GetColor(0x181822FF) : GetColor(0x0C1A12FF));
            cameraMgr.EndMode();
        
        postFX.EndRenderPassAndApplyFX(dt, player.health, player.maxHealth, screenW, screenH);

        // HUD & Overlays
        player.DrawHUD();
        combatMgr.DrawCombatHUD(screenW);
        input.DrawInputTypeHUD(screenW, screenH);
        classMgr.DrawClassAndAbilityHUD(screenW, screenH);
        questMgr.DrawQuestTrackerHUD(screenW);
        setGemMgr.DrawSetBonusesHUD(screenW);
        
        if (portals.currentScene == SCENE_DUNGEON) {
            act2Crypts.DrawAct2HUD(screenW); // Poison HUD & Malgor Boss Bar
            floorMgr.DrawFloorHUD(screenW);
            minimap.DrawMinimapHUD(screenW, dungeon, player.pos, act2Crypts.bossPos, act2Crypts.bossHp > 0, portals.dungeonReturnPortal.pos, portals.dungeonReturnPortal.active);
        }

        talentTree.Draw(screenW, screenH, mousePos);
        gearMgr.DrawEquipmentUI(screenW, screenH, mousePos);
        metaMgr.DrawVendorUI(screenW, screenH, player.gold, mousePos);
        classMgr.DrawClassSelectionMenu(screenW, screenH, mousePos);
        questMgr.DrawDialogueUI(screenW, screenH, player.gold, metaMgr.bossSouls);
        floorMgr.DrawTransitionOverlay(screenW, screenH);

        DrawText("ACT II: THE SUNKEN CRYPTS", 20, 15, 11, LIME);

        EndDrawing();
    }

    synthAudio.Unload();
    audio.Unload();
    postFX.Unload();
    CloseWindow();
    return 0;
}
};
