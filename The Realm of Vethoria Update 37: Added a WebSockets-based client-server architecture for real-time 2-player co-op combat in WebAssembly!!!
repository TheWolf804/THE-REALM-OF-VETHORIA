#include "raylib.h"
#include <iostream>
#include <string>

#ifdef __EMSCRIPTEN__
#include <emscripten.h>
#endif

struct PeerState {
    int id = -1;
    Vector2 pos = { 0, 0 };
    Vector2 targetPos = { 0, 0 }; // For smooth linear interpolation
    float hp = 100.0f;
    int classType = 0;
    bool active = false;
};

class NetworkClient {
public:
    int localPlayerId = -1;
    bool isHost = false;
    PeerState peer;

    void Init(const char* serverUrl) {
#ifdef __EMSCRIPTEN__
        EM_ASM({
            const url = UTF8ToString($0);
            window.gameSocket = new WebSocket(url);

            window.gameSocket.onopen = () => {
                console.log("[WASM Network] Connected to server.");
            };

            window.gameSocket.onmessage = (event) => {
                const msg = JSON.parse(event.data);
                if (msg.type === "init") {
                    Module.localPlayerId = msg.playerId;
                    Module.isHost = msg.isHost;
                } else if (msg.type === "peer_update") {
                    Module.peerX = msg.x;
                    Module.peerY = msg.y;
                    Module.peerHp = msg.hp;
                    Module.peerClass = msg.class;
                    Module.peerActive = true;
                } else if (msg.type === "peer_left") {
                    Module.peerActive = false;
                }
            };
        }, serverUrl);
#endif
    }

    void Update(Vector2 localPos, float localHp, int classType, float dt) {
#ifdef __EMSCRIPTEN__
        // Query JS state populated by socket callbacks
        localPlayerId = EM_ASM_INT({ return Module.localPlayerId || -1; });
        isHost = EM_ASM_INT({ return Module.isHost ? 1 : 0; });
        
        peer.active = EM_ASM_INT({ return Module.peerActive ? 1 : 0; });

        if (peer.active) {
            peer.targetPos.x = (float)EM_ASM_DOUBLE({ return Module.peerX || 0; });
            peer.targetPos.y = (float)EM_ASM_DOUBLE({ return Module.peerY || 0; });
            peer.hp = (float)EM_ASM_DOUBLE({ return Module.peerHp || 100; });
            peer.classType = EM_ASM_INT({ return Module.peerClass || 0; });

            // Linear Interpolation (LERP) for smooth movement across network frames
            peer.pos.x += (peer.targetPos.x - peer.pos.x) * 15.0f * dt;
            peer.pos.y += (peer.targetPos.y - peer.pos.y) * 15.0f * dt;
        }

        // Send outbound local state (Throttle rate via delta time if necessary)
        EM_ASM({
            if (window.gameSocket && window.gameSocket.readyState === WebSocket.OPEN) {
                window.gameSocket.send(JSON.stringify({
                    type: "state_update",
                    x: $0,
                    y: $1,
                    hp: $2,
                    class: $3
                }));
            }
        }, (double)localPos.x, (double)localPos.y, (double)localHp, classType);
#endif
    }

    void DrawPeer() {
        if (!peer.active) return;

        Color peerColor = SKYBLUE;
        if (peer.classType == 0) peerColor = RED;      // Warrior
        else if (peer.classType == 1) peerColor = GOLD; // Mage
        else if (peer.classType == 2) peerColor = LIME; // Rogue

        DrawCircleV(peer.pos, 16.0f, peerColor);
        DrawCircleLines((int)peer.pos.x, (int)peer.pos.y, 18.0f, WHITE);
        DrawText("P2 (CO-OP)", (int)peer.pos.x - 28, (int)peer.pos.y - 32, 11, RAYWHITE);
        
        // Peer Health Bar
        DrawRectangle((int)peer.pos.x - 20, (int)peer.pos.y - 22, 40, 5, RED);
        DrawRectangle((int)peer.pos.x - 20, (int)peer.pos.y - 22, (int)(40 * (peer.hp / 100.0f)), 5, GREEN);
    }
};
