int main() {
    const int screenW = 1280, screenH = 720;
    InitWindow(screenW, screenH, "Vethoria: WebSockets 2-Player Co-Op");
    SetTargetFPS(60);

    TextureManager textureMgr;
    textureMgr.LoadAll();

    SoundManager soundMgr;
    soundMgr.Init();

    Player player;
    BossManager boss;
    ParticleEngine particles;
    LightEngine lighting(screenW, screenH);
    EnemyWaveManager waves;
    Minimap minimap;
    CameraManager cameraMgr(screenW, screenH);
    DungeonGenerator dungeon;
    NetworkClient netClient;

    // Connect to WebSockets backend server
    netClient.Init("ws://localhost:8080");

    dungeon.Generate();
    player.pos = dungeon.playerSpawnPos;
    boss.pos = dungeon.bossSpawnPos;

    while (!WindowShouldClose()) {
        float dt = GetFrameTime();

        player.Update(dt, particles);
        
        // Synchronize state with network peer
        netClient.Update(player.pos, player.health, (int)player.classSys.currentClass, dt);

        waves.Update(dt, player, particles);
        particles.Update(dt);

        float dummyHP = player.health;
        boss.Update(dt, player.pos, (float)player.totalDefense, dummyHP, particles);

        cameraMgr.Update(player.pos, netClient.peer.active ? netClient.peer.pos : boss.pos, true, dt);

        BeginDrawing();
        ClearBackground(BLACK);

        cameraMgr.BeginMode();
            dungeon.Draw();
            boss.Draw();
            waves.Draw();
            
            // Draw Local Player and Remote Peer
            player.Draw();
            netClient.DrawPeer();
            
            particles.Draw();

            lighting.BeginLightPass();
            lighting.DrawLight(player.pos, 250.0f, ORANGE, 0.85f);
            if (netClient.peer.active) {
                lighting.DrawLight(netClient.peer.pos, 250.0f, SKYBLUE, 0.85f);
            }
            lighting.EndLightPass(GetColor(0x181822FF));
        cameraMgr.EndMode();

        // Overlay HUD
        player.DrawHUD();

        DrawRectangle(0, screenH - 30, screenW, 30, GetColor(0x12121AFF));
        DrawText(TextFormat("NETWORK STATUS: %s | PLAYER ID: %d", 
                 netClient.peer.active ? "CONNECTED TO PEER" : "SEARCHING FOR P2...", netClient.localPlayerId), 
                 20, screenH - 22, 13, netClient.peer.active ? GREEN : YELLOW);

        EndDrawing();
    }

    CloseWindow();
    return 0;
}
