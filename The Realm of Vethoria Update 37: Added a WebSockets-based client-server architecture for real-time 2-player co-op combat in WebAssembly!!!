const WebSocket = require('ws');
const wss = new WebSocket.Server({ port: 8080 });

console.log("Vethoria Co-Op WebSocket Server running on ws://localhost:8080");

let players = {};
let nextPlayerId = 1;

wss.on('connection', (ws) => {
    const playerId = nextPlayerId++;
    players[playerId] = { ws, x: 200, y: 200, hp: 100, isHost: playerId === 1 };

    console.log(`Player ${playerId} connected. Host status: ${players[playerId].isHost}`);

    // Send assignment info to connecting client
    ws.send(JSON.stringify({
        type: "init",
        playerId: playerId,
        isHost: players[playerId].isHost
    }));

    // Broadcast updated player count
    broadcast({
        type: "peer_joined",
        totalPlayers: Object.keys(players).length
    });

    ws.on('message', (message) => {
        try {
            const data = JSON.parse(message);
            
            if (data.type === "state_update") {
                players[playerId].x = data.x;
                players[playerId].y = data.y;
                players[playerId].hp = data.hp;

                // Relay update to peer
                broadcastToOthers(playerId, {
                    type: "peer_update",
                    peerId: playerId,
                    x: data.x,
                    y: data.y,
                    hp: data.hp,
                    class: data.class
                });
            } else if (data.type === "ability_trigger") {
                broadcastToOthers(playerId, {
                    type: "peer_ability",
                    peerId: playerId,
                    abilityKey: data.abilityKey,
                    x: data.x,
                    y: data.y
                });
            }
        } catch (e) {
            console.error("Invalid packet:", e);
        }
    });

    ws.on('close', () => {
        delete players[playerId];
        console.log(`Player ${playerId} disconnected.`);
        broadcast({ type: "peer_left", peerId: playerId });
    });
});

function broadcast(data) {
    const payload = JSON.stringify(data);
    wss.clients.forEach(client => {
        if (client.readyState === WebSocket.OPEN) {
            client.send(payload);
        }
    });
}

function broadcastToOthers(senderId, data) {
    const payload = JSON.stringify(data);
    Object.keys(players).forEach(id => {
        if (parseInt(id) !== senderId && players[id].ws.readyState === WebSocket.OPEN) {
            players[id].ws.send(payload);
        }
    });
