#!/bin/bash
set -e

echo "=================================================="
echo "      Vethoria Compilation & Build Verification    "
echo "=================================================="

# 1. Create and configure build directory
echo "[1/3] Configuring CMake project..."
cmake -B build_native -DCMAKE_BUILD_TYPE=Release

# 2. Compile all targets
echo "[2/3] Compiling source files and modules..."
cmake --build build_native --config Release -j$(nproc)

# 3. Verification status
echo "[3/3] Build completed successfully!"
echo "Executable binary generated at: build_native/vethoria"
