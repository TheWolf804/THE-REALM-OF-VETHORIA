enum CharacterClassType {
    CLASS_WARRIOR,
    CLASS_MAGE,
    CLASS_ROGUE
};

enum SkillType {
    SKILL_PASSIVE_STAT,
    SKILL_ACTIVE_ABILITY
};

struct SkillNode {
    int id;
    char name[32];
    char description[64];
    SkillType type;
    int tier;              // Unlock requirement (Level/Points)
    bool unlocked = false;
    int requiredNodeId = -1; // Dependency node (-1 for base)
    
    // Bonus Attributes / Skill Effects
    int bonusAtk = 0;
    int bonusDef = 0;
    int bonusHp = 0;
    float cooldown = 0.0f;
    float currentCd = 0.0f;
};

class ClassSystem {
public:
    CharacterClassType currentClass = CLASS_WARRIOR;
    std::vector<SkillNode> skillTree;

    // Ability States & Cooldowns
    float abilityQ_CD = 0.0f;
    float abilityE_CD = 0.0f;
    float qMaxCD = 5.0f;
    float eMaxCD = 10.0f;

    // Buff tracking
    float shieldTimer = 0.0f;
    float speedBuffTimer = 0.0f;

    ClassSystem() {
        SelectClass(CLASS_WARRIOR);
    }

    void SelectClass(CharacterClassType type) {
        currentClass = type;
        skillTree.clear();

        if (type == CLASS_WARRIOR) {
            qMaxCD = 4.0f; // Ground Slam
            eMaxCD = 8.0f; // Iron Shield

            skillTree.push_back({ 0, "Iron Clad", "+15 Defense", SKILL_PASSIVE_STAT, 1, false, -1, 0, 15, 0, 0, 0 });
            skillTree.push_back({ 1, "Ground Slam [Q]", "AOE Damage around player", SKILL_ACTIVE_ABILITY, 1, false, 0, 0, 0, 0, 4.0f });
            skillTree.push_back({ 2, "Iron Shield [E]", "Grant temporary invulnerability", SKILL_ACTIVE_ABILITY, 2, false, 1, 0, 0, 0, 8.0f });
        } 
        else if (type == CLASS_MAGE) {
            qMaxCD = 3.0f; // Frost Nova
            eMaxCD = 12.0f; // Arcane Intellect

            skillTree.push_back({ 0, "Arcane Focus", "+25 Bonus Mana & +10 Atk", SKILL_PASSIVE_STAT, 1, false, -1, 10, 0, 25, 0, 0 });
            skillTree.push_back({ 1, "Frost Nova [Q]", "Freeze and damage nearby foes", SKILL_ACTIVE_ABILITY, 1, false, 0, 0, 0, 0, 3.0f });
            skillTree.push_back({ 2, "Arcane Surge [E]", "Instantly restore 50 Mana", SKILL_ACTIVE_ABILITY, 2, false, 1, 0, 0, 0, 12.0f });
        } 
        else if (type == CLASS_ROGUE) {
            qMaxCD = 2.5f; // Shadow Dash
            eMaxCD = 10.0f; // Poison Blade

            skillTree.push_back({ 0, "Fleet Foot", "+15% Speed & +10 Atk", SKILL_PASSIVE_STAT, 1, false, -1, 10, 0, 0, 0, 0 });
            skillTree.push_back({ 1, "Shadow Dash [Q]", "Blink forward rapidly", SKILL_ACTIVE_ABILITY, 1, false, 0, 0, 0, 0, 2.5f });
            skillTree.push_back({ 2, "Deadly Precision [E]", "Increases speed and attack", SKILL_ACTIVE_ABILITY, 2, false, 1, 15, 0, 0, 10.0f });
        }
    }

    void Update(float dt) {
        if (abilityQ_CD > 0.0f) abilityQ_CD -= dt;
        if (abilityE_CD > 0.0f) abilityE_CD -= dt;
        if (shieldTimer > 0.0f) shieldTimer -= dt;
        if (speedBuffTimer > 0.0f) speedBuffTimer -= dt;
    }

    // Execute Active Ability Q
    bool TriggerAbilityQ(Vector2 playerPos, ParticleEngine& particles, float& mana) {
        if (abilityQ_CD > 0.0f) return false;

        if (currentClass == CLASS_WARRIOR && skillTree[1].unlocked) {
            abilityQ_CD = qMaxCD;
            particles.Emit(playerPos, RED, 35, 100.0f, 300.0f); // Slam shockwave
            return true;
        } 
        else if (currentClass == CLASS_MAGE && skillTree[1].unlocked && mana >= 20.0f) {
            mana -= 20.0f;
            abilityQ_CD = qMaxCD;
            particles.Emit(playerPos, SKYBLUE, 40, 120.0f, 250.0f); // Frost Ring
            return true;
        } 
        else if (currentClass == CLASS_ROGUE && skillTree[1].unlocked) {
            abilityQ_CD = qMaxCD;
            particles.Emit(playerPos, PURPLE, 20, 50.0f, 150.0f);
            return true;
        }
        return false;
    }

    // Execute Active Ability E
    bool TriggerAbilityE(Vector2 playerPos, ParticleEngine& particles, float& mana, float& health, float maxMana) {
        if (abilityE_CD > 0.0f) return false;

        if (currentClass == CLASS_WARRIOR && skillTree[2].unlocked) {
            abilityE_CD = eMaxCD;
            shieldTimer = 3.0f; // 3 Seconds Invulnerability
            particles.Emit(playerPos, GOLD, 30, 40.0f, 120.0f);
            return true;
        } 
        else if (currentClass == CLASS_MAGE && skillTree[2].unlocked) {
            abilityE_CD = eMaxCD;
            mana = std::min(maxMana, mana + 50.0f); // Surge Mana
            particles.Emit(playerPos, BLUE, 30, 60.0f, 180.0f);
            return true;
        } 
        else if (currentClass == CLASS_ROGUE && skillTree[2].unlocked) {
            abilityE_CD = eMaxCD;
            speedBuffTimer = 5.0f;
            particles.Emit(playerPos, LIME, 25, 80.0f, 200.0f);
            return true;
        }
        return false;
    }

    void UnlockSkillNode(int index, int& availablePoints) {
        if (index < 0 || index >= (int)skillTree.size()) return;
        if (availablePoints <= 0 || skillTree[index].unlocked) return;

        // Check requirement
        if (skillTree[index].requiredNodeId != -1) {
            int req = skillTree[index].requiredNodeId;
            if (!skillTree[req].unlocked) return;
        }

        skillTree[index].unlocked = true;
        availablePoints--;
    }
