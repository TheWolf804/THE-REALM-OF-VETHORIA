struct VirtualJoystick {
    Vector2 center = { 120.0f, 600.0f };
    float outerRadius = 60.0f;
    float innerRadius = 25.0f;
    Vector2 handlePos = { 120.0f, 600.0f };
    bool isDragging = false;
    int touchId = -1;
    Vector2 outputVector = { 0.0f, 0.0f };
};

struct TouchActionButton {
    Rectangle bounds;
    std::string label;
    Color color;
    bool isPressed = false;
};

class WasmWebManager {
public:
    VirtualJoystick joystick;
    TouchActionButton dodgeButton;
    TouchActionButton abilityButton;
    bool isMobileOrWebTouch = false;

    void Init() {
#if defined(__EMSCRIPTEN__)
        // Mount Persistent Virtual File System (MEMFS -> IndexedDB)
        EM_ASM(
            FS.mkdir('/offline');
            FS.mount(IDBFS, {}, '/offline');
            FS.syncfs(true, function (err) {
                if (err) console.error('IndexedDB Mount Error:', err);
                else console.log('IndexedDB Persistent Filesystem Mounted!');
            });
        );
#endif

        // Setup Virtual Touch Controls
        joystick.center = { 120.0f, 580.0f };
        joystick.handlePos = joystick.center;

        dodgeButton = { { 1100.0f, 550.0f, 70.0f, 70.0f }, "DODGE", SKYBLUE, false };
        abilityButton = { { 1190.0f, 470.0f, 70.0f, 70.0f }, "ABILITY", GOLD, false };
    }

    void SyncToIndexedDB() {
#if defined(__EMSCRIPTEN__)
        // Flush memory virtual filesystem to IndexedDB
        EM_ASM(
            FS.syncfs(false, function (err) {
                if (err) console.error('IndexedDB Auto-Save Sync Error:', err);
                else console.log('Game State Successfully Synced to IndexedDB!');
            });
        );
#endif
    }

    void UpdateTouchControls(Vector2& outMoveInput, bool& outDodgeTrigger, bool& outAbilityTrigger) {
        outDodgeTrigger = false;
        outAbilityTrigger = false;

        int touchCount = GetTouchPointCount();
        if (touchCount > 0) isMobileOrWebTouch = true;

        if (!isMobileOrWebTouch) return;

        // 1. Process Virtual Joystick Touch Drag
        bool foundJoystickTouch = false;
        for (int i = 0; i < touchCount; i++) {
            Vector2 touchPos = GetTouchPosition(i);

            if (!joystick.isDragging && CheckCollisionCircles(touchPos, 20.0f, joystick.center, joystick.outerRadius)) {
                joystick.isDragging = true;
                joystick.touchId = i;
            }

            if (joystick.isDragging && joystick.touchId == i) {
                foundJoystickTouch = true;
                Vector2 diff = Vector2Subtract(touchPos, joystick.center);
                float dist = Vector2Length(diff);

                if (dist > joystick.outerRadius) {
                    diff = Vector2Scale(Vector2Normalize(diff), joystick.outerRadius);
                }

                joystick.handlePos = Vector2Add(joystick.center, diff);
                joystick.outputVector = Vector2Scale(diff, 1.0f / joystick.outerRadius);
                outMoveInput = joystick.outputVector;
            }

            // 2. Process Action Buttons
            if (CheckCollisionPointRec(touchPos, dodgeButton.bounds)) {
                if (!dodgeButton.isPressed) {
                    outDodgeTrigger = true;
                    dodgeButton.isPressed = true;
                }
            } else {
                dodgeButton.isPressed = false;
            }

            if (CheckCollisionPointRec(touchPos, abilityButton.bounds)) {
                if (!abilityButton.isPressed) {
                    outAbilityTrigger = true;
                    abilityButton.isPressed = true;
                }
            } else {
                abilityButton.isPressed = false;
            }
        }

        if (!foundJoystickTouch) {
            joystick.isDragging = false;
            joystick.handlePos = joystick.center;
            joystick.outputVector = { 0.0f, 0.0f };
        }
    }

    void DrawTouchControlsHUD() {
        if (!isMobileOrWebTouch) return;

        // Draw Virtual Joystick
        DrawCircleV(joystick.center, joystick.outerRadius, ColorAlpha(DARKGRAY, 0.4f));
        DrawCircleLines((int)joystick.center.x, (int)joystick.center.y, joystick.outerRadius, GRAY);
        DrawCircleV(joystick.handlePos, joystick.innerRadius, ColorAlpha(SKYBLUE, 0.8f));

        // Draw Touch Buttons
        DrawRectangleRounded(dodgeButton.bounds, 0.3f, 4, ColorAlpha(dodgeButton.color, dodgeButton.isPressed ? 0.9f : 0.5f));
        DrawRectangleRoundedLinesEx(dodgeButton.bounds, 0.3f, 4, 2.0f, WHITE);
        DrawText(dodgeButton.label.c_str(), (int)dodgeButton.bounds.x + 12, (int)dodgeButton.bounds.y + 28, 11, WHITE);

        DrawRectangleRounded(abilityButton.bounds, 0.3f, 4, ColorAlpha(abilityButton.color, abilityButton.isPressed ? 0.9f : 0.5f));
        DrawRectangleRoundedLinesEx(abilityButton.bounds, 0.3f, 4, 2.0f, WHITE);
        DrawText(abilityButton.label.c_str(), (int)abilityButton.bounds.x + 8, (int)abilityButton.bounds.y + 28, 10, WHITE);
    }
cmake_minimum_required(VERSION 3.16)
project(VethoriaWasm CXX)

set(CMAKE_CXX_STANDARD 17)

# Emscripten Specific Compiler & Linker Flags
