// Note: Ensure nlohmann/json.hpp is included in your project dependencies
#include "nlohmann/json.hpp"

using json = nlohmann::json;

struct SaveItemData {
    std::string name;
    int rarity;
    int itemType;
    int statValue;
};

struct GameSaveData {
    // Player Stats
    int level = 1;
    float currentHealth = 100.0f;
    float maxHealth = 100.0f;
    int gold = 250;
    int availableSkillPoints = 0;

    // Talent Tree Unlocks (Node ID -> Current Rank)
    std::vector<std::pair<int, int>> talentRanks;

    // Quests
    int currentQuestStage = 0;
    bool bossQuestCompleted = false;

    // Inventory
    std::vector<SaveItemData> inventory;
};

class SaveLoadManager {
public:
    std::string saveFilePath = "savegame.json";

    bool SaveGame(const Player& player, int playerGold, const TalentTreeManager& talentTree, const DialogueAndTownManager& town) {
        json j;

        // 1. Serialize Player Stats
        j["player"]["level"] = 1; // Expand level if tracked
        j["player"]["currentHealth"] = player.health;
        j["player"]["maxHealth"] = player.maxHealth;
        j["player"]["gold"] = playerGold;
        j["player"]["skillPoints"] = talentTree.availablePoints;

        // 2. Serialize Talent Tree
        json talentsJson = json::array();
        for (const auto& node : talentTree.nodes) {
            talentsJson.push_back({
                {"id", node.id},
                {"rank", node.currentRank}
            });
        }
        j["talents"] = talentsJson;

        // 3. Serialize Quest Data
        j["quests"]["stage"] = town.currentQuestStage;
        j["quests"]["bossDefeated"] = town.questCompleted;

        // 4. Serialize Inventory
        json invJson = json::array();
        for (const auto& item : player.inventory) {
            invJson.push_back({
                {"name", item.name},
                {"rarity", (int)item.rarity},
                {"statValue", item.statValue}
            });
        }
        j["inventory"] = invJson;

        // Write JSON to disk
        std::ofstream file(saveFilePath);
        if (file.is_open()) {
            file << j.dump(4); // 4 spaces indentation
            file.close();
            TraceLog(LOG_INFO, "SAVE SYSTEM: Game successfully saved to %s", saveFilePath.c_str());
            return true;
        }

        TraceLog(LOG_ERROR, "SAVE SYSTEM: Failed to write save file!");
        return false;
    }

    bool LoadGame(Player& player, int& playerGold, TalentTreeManager& talentTree, DialogueAndTownManager& town) {
        std::ifstream file(saveFilePath);
        if (!file.is_open()) {
            TraceLog(LOG_WARNING, "SAVE SYSTEM: Save file %s not found.", saveFilePath.c_str());
            return false;
        }

        json j;
        try {
            file >> j;
            file.close();

            // 1. Restore Player Stats & Gold
            player.health = j["player"].value("currentHealth", 100.0f);
            player.maxHealth = j["player"].value("maxHealth", 100.0f);
            playerGold = j["player"].value("gold", 250);
            talentTree.availablePoints = j["player"].value("skillPoints", 0);

            // 2. Restore Talent Node Ranks
            if (j.contains("talents")) {
                for (const auto& t : j["talents"]) {
                    int nodeId = t.value("id", -1);
                    int nodeRank = t.value("rank", 0);

                    for (auto& node : talentTree.nodes) {
                        if (node.id == nodeId) {
                            node.currentRank = nodeRank;
                            node.isUnlocked = (nodeRank > 0);
                        }
                    }
                }
                talentTree.RecalculateStats(); // Reapply stat bonuses to player
            }

            // 3. Restore Quests
            if (j.contains("quests")) {
                town.currentQuestStage = j["quests"].value("stage", 0);
                town.questCompleted = j["quests"].value("bossDefeated", false);
            }

            // 4. Restore Inventory Items
            if (j.contains("inventory")) {
                player.inventory.clear();
                for (const auto& item : j["inventory"]) {
                    Item newItem;
                    newItem.name = item.value("name", "Unknown Item");
                    newItem.rarity = (ItemRarity)item.value("rarity", 0);
                    newItem.statValue = item.value("statValue", 0);
                    player.inventory.push_back(newItem);
                }
            }

            TraceLog(LOG_INFO, "SAVE SYSTEM: Game successfully loaded from %s", saveFilePath.c_str());
            return true;
        }
        catch (const std::exception& e) {
            TraceLog(LOG_ERROR, "SAVE SYSTEM: Parse error while loading JSON: %s", e.what());
            file.close();
            return false;
        }
    }
#include "raylib.h"
#include "Common.h"
#include "ParticleEngine.h"
#include "Player.h"
#include "LightEngine.h"
#include "CameraManager.h"
#include "PostProcessingManager.h"
#include "DungeonGenerator.h"
#include "BossBehaviorTree.h"
#include "LootSystem.h"
