cmake_minimum_required(VERSION 3.20)
project(VethoriaEngine VERSION 1.0.0 LANGUAGES C CXX)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

# Configure Output Directories
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin)
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/lib)

# -----------------------------------------------------------------------------
# 1. Dependency Management: Raylib
# -----------------------------------------------------------------------------
include(FetchContent)

# Option to use system-installed Raylib or fetch dynamically
option(USE_EXTERNAL_RAYLIB "Use system installed Raylib" OFF)

if(NOT USE_EXTERNAL_RAYLIB)
    message(STATUS "Fetching Raylib dependency from GitHub...")
    FetchContent_Declare(
        raylib
        GIT_REPOSITORY https://github.com/raysan5/raylib.git
        GIT_TAG        5.0
        GIT_SHALLOW    TRUE
    )
    set(BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
    set(CUSTOMIZE_BUILD OFF CACHE BOOL "" FORCE)
    FetchContent_MakeAvailable(raylib)
else()
    find_package(raylib REQUIRED)
endif()

# -----------------------------------------------------------------------------
# 2. Source & Header Files Collection
# -----------------------------------------------------------------------------
include_directories(include)

file(GLOB ENGINE_SOURCES 
    "src/*.cpp"
)

# Filter out main.cpp when linking engine components into test executable
set(ENGINE_CORE_SOURCES ${ENGINE_SOURCES})
list(FILTER ENGINE_CORE_SOURCES EXCLUDE REGEX "src/main.cpp")

# -----------------------------------------------------------------------------
# 3. Main Executable Target
# -----------------------------------------------------------------------------
add_executable(VethoriaGame ${ENGINE_SOURCES})
target_link_libraries(VethoriaGame PRIVATE raylib)

# Platform-Specific Linker Flags
if(WIN32)
    target_link_libraries(VethoriaGame PRIVATE opengl32 gdi32 winmm)
elseif(APPLE)
    find_library(OPENGL_LIBRARY OpenGL)
    find_library(COCOA_LIBRARY Cocoa)
    find_library(IOKIT_LIBRARY IOKit)
    find_library(COREVIDEO_LIBRARY CoreVideo)
    target_link_libraries(VethoriaGame PRIVATE ${OPENGL_LIBRARY} ${COCOA_LIBRARY} ${IOKIT_LIBRARY} ${COREVIDEO_LIBRARY})
elseif(UNIX AND NOT APPLE)
    target_link_libraries(VethoriaGame PRIVATE GL pthread m dl rt X11)
endif()

# Copy Assets folder to binary directory upon build
add_custom_command(
    TARGET VethoriaGame POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy_directory
    ${CMAKE_CURRENT_SOURCE_DIR}/assets
    $<TARGET_FILE_DIR:VethoriaGame>/assets
    COMMENT "Copying game assets to execution directory..."
)

# -----------------------------------------------------------------------------
# 4. Unit Testing Executable Target
# -----------------------------------------------------------------------------
enable_testing()

add_executable(VethoriaTests tests/test_main.cpp ${ENGINE_CORE_SOURCES})
target_link_libraries(VethoriaTests PRIVATE raylib)
{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug Build",
      "description": "Configure for debug build with debug symbols",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release Build",
      "description": "Configure for optimized release build",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ]
}
#!/usr/bin/env bash
set -e

BUILD_TYPE=${1:-Debug}
BUILD_DIR="build/$(echo $BUILD_TYPE | tr '[:upper:]' '[:lower:]')"

echo "======================================================"
echo " Building Vethoria Engine ($BUILD_TYPE) - Linux/macOS"
echo "======================================================"

mkdir -p $BUILD_DIR
cd $BUILD_DIR

cmake -DCMAKE_BUILD_TYPE=$BUILD_TYPE ../..
cmake --build . --parallel $(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)

echo ""
echo "======================================================"
echo " Executing Engine Unit Test Suite..."
echo "======================================================"
ctest --output-on-failure

echo ""
echo "Build complete! Executable located at: $BUILD_DIR/bin/VethoriaGame"
@echo off
set BUILD_TYPE=Debug
if not "%~1"=="" set BUILD_TYPE=%~1

set BUILD_DIR=build\%BUILD_TYPE%

echo ======================================================
echo  Building Vethoria Engine (%BUILD_TYPE%) - Windows
echo ======================================================

if not exist %BUILD_DIR% mkdir %BUILD_DIR%
cd %BUILD_DIR%

cmake -G "Visual Studio 17 2022" -A x64 -DCMAKE_BUILD_TYPE=%BUILD_TYPE% ..\..
cmake --build . --config %BUILD_TYPE%

echo.
echo ======================================================
echo  Executing Engine Unit Test Suite...
echo ======================================================
ctest -C %BUILD_TYPE% --output-on-failure

cd ..\..
echo.
echo Build complete! Executable located at: %BUILD_DIR%\bin\%BUILD_TYPE%\VethoriaGame.exe


add_test(NAME VethoriaEngineTests COMMAND VethoriaTests)
