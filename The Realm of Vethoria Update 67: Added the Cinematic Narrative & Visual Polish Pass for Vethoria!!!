#pragma once
#include "raylib.h"
#include "raymath.h"
#include <vector>
#include <string>

struct MonsterCodexEntry {
    std::string name;
    std::string biome;
    std::string description;
    int baseHp;
    bool isDiscovered;
    Color themeColor;
};

class CinematicAndPolishManager {
public:
    // Cinematic Intro State
    bool isCinematicActive = false;
    float cinematicTimer = 0.0f;
    std::string cinematicBossTitle = "";
    Vector2 cinematicTargetPos = { 0, 0 };

    // Chromatic Aberration & Hit FX
    float chromaticAberrationTimer = 0.0f;
    float screenShakeTimer = 0.0f;
    float screenShakeIntensity = 0.0f;

    // Lore Codex UI State
    bool isCodexOpen = false;
    int selectedCodexIndex = 0;
    std::vector<MonsterCodexEntry> codexEntries;

    void InitCodex() {
        codexEntries = {
            { "Crypt Stalker", "Sunken Crypts", "Agile undead lurking in stagnant poison sludge pools. Attacks with envenomed claws.", 110, true, LIME },
            { "Necrotic Abomination", "Sunken Crypts", "Massive bloated corpse pulsating with toxic decay. Releases poison bursts upon destruction.", 240, true, DARKGREEN },
            { "Malgor, Lord of Decay", "Sunken Crypts", "Ancient overlord of the subterranean crypts. Commands toxic rings and minion hordes.", 1800, true, GREEN },
            { "Pyrexia, Flame Sovereign", "Lava Caverns", "Elemental entity born from primordial magma cores. Incinerates intruders with fire waves.", 1500, false, ORANGE },
            { "Glacial Warden", "Ice Vaults", "Sentient armor enchanted with absolute zero frost runes. Unleashes freezing shockwaves.", 1600, false, SKYBLUE }
        };
    }

    void TriggerBossCinematic(std::string bossName, Vector2 bossPos) {
        isCinematicActive = true;
        cinematicTimer = 3.5f; // 3.5 seconds cinematic intro pan
        cinematicBossTitle = bossName;
        cinematicTargetPos = bossPos;
    }

    void TriggerCriticalHitFX() {
        chromaticAberrationTimer = 0.35f; // 350ms chromatic aberration pulse
        screenShakeTimer = 0.25f;
        screenShakeIntensity = 8.0f;
    }

    void Update(float dt) {
        if (isCinematicActive) {
            cinematicTimer -= dt;
            if (cinematicTimer <= 0.0f) {
                isCinematicActive = false;
            }
        }

        if (chromaticAberrationTimer > 0.0f) {
            chromaticAberrationTimer -= dt;
        }

        if (screenShakeTimer > 0.0f) {
            screenShakeTimer -= dt;
        }
    }

    Vector2 ApplyScreenShake(Vector2 cameraPos) {
        if (screenShakeTimer > 0.0f) {
            float offsetX = (float)GetRandomValue(-(int)screenShakeIntensity, (int)screenShakeIntensity);
            float offsetY = (float)GetRandomValue(-(int)screenShakeIntensity, (int)screenShakeIntensity);
            return { cameraPos.x + offsetX, cameraPos.y + offsetY };
        }
        return cameraPos;
    }

    void DrawCinematicLetterboxBars(int screenW, int screenH) {
        if (!isCinematicActive) return;

        int barH = 90;
        // Top Letterbox Bar
        DrawRectangle(0, 0, screenW, barH, BLACK);
        // Bottom Letterbox Bar
        DrawRectangle(0, screenH - barH, screenW, barH, BLACK);

        // Boss Title Reveal
        float alpha = (cinematicTimer > 3.0f) ? (3.5f - cinematicTimer) / 0.5f : ((cinematicTimer < 0.5f) ? cinematicTimer / 0.5f : 1.0f);
        Color titleCol = ColorAlpha(GOLD, alpha);
        
        const char* subText = "BOSS ENCOUNTER";
        DrawText(subText, (screenW - MeasureText(subText, 12)) / 2, screenH - barH + 20, 12, ColorAlpha(LIGHTGRAY, alpha));
        DrawText(cinematicBossTitle.c_str(), (screenW - MeasureText(cinematicBossTitle.c_str(), 24)) / 2, screenH - barH + 42, 24, titleCol);
    }

    void DrawCodexUI(int screenW, int screenH, Vector2 mousePos) {
        if (!isCodexOpen) return;

        int uiW = 750, uiH = 460;
        int uiX = (screenW - uiW) / 2;
        int uiY = (screenH - uiH) / 2;

        DrawRectangle(0, 0, screenW, screenH, ColorAlpha(BLACK, 0.75f));
        DrawRectangle(uiX, uiY, uiW, uiH, GetColor(0x12121DFF));
        DrawRectangleLines(uiX, uiY, uiW, uiH, GOLD);

        // Header
        DrawRectangle(uiX, uiY, uiW, 45, GetColor(0x1B1B2AFF));
        DrawText("BESTIARY & LORE CODEX", uiX + 20, uiY + 15, 16, GOLD);
        DrawText("[L] Close Codex", uiX + uiW - 120, uiY + 16, 11, LIGHTGRAY);

        // Left List Column
        int listY = uiY + 65;
        for (size_t i = 0; i < codexEntries.size(); i++) {
            const auto& entry = codexEntries[i];
            Rectangle itemRec = { (float)uiX + 20, (float)listY, 260.0f, 40.0f };
            bool isSelected = (selectedCodexIndex == (int)i);
            bool isHovered = CheckCollisionPointRec(mousePos, itemRec);

            DrawRectangleRec(itemRec, isSelected ? GetColor(0x28283CFF) : GetColor(0x1A1A28FF));
            DrawRectangleLinesEx(itemRec, 1.0f, isSelected ? GOLD : DARKGRAY);

            std::string displayName = entry.isDiscovered ? entry.name : "??? (Undiscovered)";
            DrawText(displayName.c_str(), (int)itemRec.x + 12, (int)itemRec.y + 13, 11, entry.isDiscovered ? WHITE : GRAY);

            if (isHovered && IsMouseButtonPressed(MOUSE_BUTTON_LEFT)) {
                selectedCodexIndex = (int)i;
            }

            listY + 48;
        }

        // Right Detail Column
        const auto& selectedEntry = codexEntries[selectedCodexIndex];
        int detailX = uiX + 310;
        int detailY = uiY + 65;

        DrawRectangle(detailX, detailY, 415, 370, GetColor(0x181824FF));
        DrawRectangleLines(detailX, detailY, 415, 370, DARKGRAY);

        if (selectedEntry.isDiscovered) {
            DrawText(selectedEntry.name.c_str(), detailX + 20, detailY + 20, 18, selectedEntry.themeColor);
            DrawText(TextFormat("Habitat: %s", selectedEntry.biome.c_str()), detailX + 20, detailY + 50, 12, SKYBLUE);
            DrawText(TextFormat("Base Health: %d HP", selectedEntry.baseHp), detailX + 20, detailY + 72, 12, GREEN);

            DrawText("Description & Lore:", detailX + 20, detailY + 110, 12, GOLD);
            DrawText(selectedEntry.description.c_str(), detailX + 20, detailY + 135, 11, LIGHTGRAY);
        } else {
            DrawText("CLASSIFIED LORE ENTRY", detailX + 20, detailY + 30, 16, RED);
            DrawText("Defeat this entity in dungeon biomes to unlock codex records.", detailX + 20, detailY + 70, 11, GRAY);
        }
    }
