#pragma once
#include "raylib.h"
#include "raymath.h"
#include <string>
#include <vector>
#include <unordered_map>
#include <algorithm>

enum GemType {
    GEM_NONE = 0,
    GEM_RUBY,     // +Fire Damage / +Strength
    GEM_SAPPHIRE, // +Ice Resistance / +Mana Shield
    GEM_TOPAZ,    // +Crit Chance / +Gold Find
    GEM_EMERALD   // +Poison / +Health Steal
};

enum GemTier {
    GEM_TIER_CHIPPED = 0,
    GEM_TIER_FLAWLESS,
    GEM_TIER_ROYAL
};

struct SocketableGem {
    GemType type;
    GemTier tier;
    std::string name;
    int statBonusValue;

    std::string GetStatDescription() const {
        switch (type) {
            case GEM_RUBY: return TextFormat("+%d Attack Damage", statBonusValue);
            case GEM_SAPPHIRE: return TextFormat("+%d Armor Rating", statBonusValue);
            case GEM_TOPAZ: return TextFormat("+%d%% Crit Chance", statBonusValue);
            case GEM_EMERALD: return TextFormat("+%d Health Steal", statBonusValue);
            default: return "Empty Socket";
        }
    }
};

struct GearItem {
    std::string id;
    std::string name;
    std::string setId; // Empty string if not part of a set
    int slotType;      // 0: Weapon, 1: Armor, 2: Helmet, 3: Accessory
    int rarity;        // 0: Common, 1: Rare, 2: Legendary, 3: Set Item
    int maxSockets = 2;
    std::vector<SocketableGem> sockets;
};

struct SetBonusTier {
    int requiredPieces;
    std::string description;
    float statMultiplier;
    bool isActive;
};

struct GearSetProfile {
    std::string setId;
    std::string setName;
    Color themeColor;
    std::vector<SetBonusTier> tiers;
};

class SetAndGemCraftingManager {
public:
    std::unordered_map<std::string, GearSetProfile> gearSets;
    bool isCraftingUIOpen = false;

    // Crafting Slot Selection
    int selectedEquippedSlot = 0;
    int selectedInventoryGemIndex = 0;

    void InitSetProfiles() {
        gearSets.clear();

        // 1. Infernal Pyromancer Set
        GearSetProfile pyromancer;
        pyromancer.setId = "set_pyro";
        pyromancer.setName = "Infernal Pyromancer";
        pyromancer.themeColor = ORANGE;
        pyromancer.tiers = {
            { 2, "2 Pieces: +20% Fire Damage & Fire Resistance.", 0.20f, false },
            { 4, "4 Pieces: Finisher strikes ignite a burning flame aura dealing 40 DPS.", 1.0f, false }
        };

        // 2. Glacial Warden Set
        GearSetProfile warden;
        warden.setId = "set_glacial";
        warden.setName = "Glacial Warden";
        warden.themeColor = SKYBLUE;
        warden.tiers = {
            { 2, "2 Pieces: +15% Armor & +50 Max Health.", 0.15f, false },
            { 4, "4 Pieces: Taking damage releases a freezing frost nova shockwave.", 1.0f, false }
        };

        gearSets[pyromancer.setId] = pyromancer;
        gearSets[warden.setId] = warden;
    }

    void EvaluateActiveSetBonuses(const std::vector<GearItem>& equippedGear) {
        // Count equipped pieces per set
        std::unordered_map<std::string, int> setCounts;
        for (const auto& item : equippedGear) {
            if (!item.setId.empty()) {
                setCounts[item.setId]++;
            }
        }

        // Update active set bonus status
        for (auto& pair : gearSets) {
            int equippedCount = setCounts[pair.first];
            for (auto& tier : pair.second.tiers) {
                tier.isActive = (equippedCount >= tier.requiredPieces);
            }
        }
    }

    bool InsertGemIntoItem(GearItem& item, SocketableGem gem) {
        if ((int)item.sockets.size() < item.maxSockets) {
            item.sockets.push_back(gem);
            return true;
        }
        return false;
    }

    bool UnsocketGems(GearItem& item, std::vector<SocketableGem>& outGemInventory) {
        if (item.sockets.empty()) return false;
        for (const auto& g : item.sockets) {
            outGemInventory.push_back(g);
        }
        item.sockets.clear();
        return true;
    }

    bool FuseGems(std::vector<SocketableGem>& inventory, GemType type, GemTier tier) {
        int count = 0;
        std::vector<int> indicesToRemove;

        for (size_t i = 0; i < inventory.size(); i++) {
            if (inventory[i].type == type && inventory[i].tier == tier) {
                indicesToRemove.push_back(i);
                count++;
                if (count == 3) break; // Need 3 matching gems to fuse
            }
        }

        if (count < 3) return false;

        // Erase 3 lower tier gems from back to front
        for (int i = (int)indicesToRemove.size() - 1; i >= 0; i--) {
            inventory.erase(inventory.begin() + indicesToRemove[i]);
        }

        // Add 1 upgraded higher tier gem
        GemTier newTier = (tier == GEM_TIER_CHIPPED) ? GEM_TIER_FLAWLESS : GEM_TIER_ROYAL;
        int newBonus = (newTier == GEM_TIER_FLAWLESS) ? 15 : 35;
        std::string newName = (newTier == GEM_TIER_FLAWLESS) ? "Flawless Gem" : "Royal Gem";

        inventory.push_back({ type, newTier, newName, newBonus });
        return true;
    }

    void DrawSetBonusesHUD(int screenW) {
        int startX = 20;
        int startY = 150;

        for (const auto& pair : gearSets) {
            const auto& setProf = pair.second;
            bool anyActive = false;
            for (const auto& t : setProf.tiers) {
                if (t.isActive) anyActive = true;
            }

            if (!anyActive) continue;

            DrawRectangle(startX, startY, 260, 60, ColorAlpha(BLACK, 0.8f));
            DrawRectangleLines(startX, startY, 260, 60, setProf.themeColor);

            DrawText(setProf.setName.c_str(), startX + 10, startY + 8, 12, setProf.themeColor);

            int textY = startY + 26;
            for (const auto& t : setProf.tiers) {
                if (t.isActive) {
                    DrawText(TextFormat("• %s", t.description.c_str()), startX + 10, textY, 9, GREEN);
                    textY += 14;
                }
            }

            startY += 70;
        }
    }

    void DrawGemCraftingVendorUI(int screenW, int screenH, std::vector<GearItem>& equippedGear, std::vector<SocketableGem>& gemInventory, Vector2 mousePos) {
        if (!isCraftingUIOpen) return;

        int uiW = 700, uiH = 440;
        int uiX = (screenW - uiW) / 2;
        int uiY = (screenH - uiH) / 2;

        DrawRectangle(0, 0, screenW, screenH, ColorAlpha(BLACK, 0.65f));
        DrawRectangle(uiX, uiY, uiW, uiH, GetColor(0x12121DFF));
        DrawRectangleLines(uiX, uiY, uiW, uiH, GOLD);

        // Header
        DrawRectangle(uiX, uiY, uiW, 40, GetColor(0x1B1B2AFF));
        DrawText("JEWELER & GEM FORGE", uiX + 20, uiY + 12, 16, GOLD);
        DrawText("[ESC] Close", uiX + uiW - 90, uiY + 14, 11, LIGHTGRAY);

        // Equipped Gear Section (Left Column)
        DrawText("EQUIPPED GEAR SOCKETS", uiX + 25, uiY + 55, 12, SKYBLUE);
        int gearY = uiY + 80;

        for (size_t i = 0; i < equippedGear.size(); i++) {
            auto& item = equippedGear[i];
            Rectangle gearRec = { (float)uiX + 25, (float)gearY, 300.0f, 65.0f };
            bool isSelected = (selectedEquippedSlot == (int)i);

            DrawRectangleRec(gearRec, isSelected ? GetColor(0x28283CFF) : GetColor(0x181824FF));
            DrawRectangleLinesEx(gearRec, 1.0f, isSelected ? GOLD : DARKGRAY);

            DrawText(item.name.c_str(), (int)gearRec.x + 10, (int)gearRec.y + 8, 12, WHITE);
            DrawText(TextFormat("Sockets: %d/%d", (int)item.sockets.size(), item.maxSockets), (int)gearRec.x + 10, (int)gearRec.y + 26, 10, GRAY);

            // Socket Icons
            for (int s = 0; s < item.maxSockets; s++) {
                int sockX = (int)gearRec.x + 180 + s * 24;
                int sockY = (int)gearRec.y + 22;

                if (s < (int)item.sockets.size()) {
                    Color gemCol = (item.sockets[s].type == GEM_RUBY) ? RED : ((item.sockets[s].type == GEM_SAPPHIRE) ? SKYBLUE : GOLD);
                    DrawCircle(sockX, sockY, 8, gemCol);
                } else {
                    DrawCircleLines(sockX, sockY, 8, DARKGRAY);
                }
            }

            if (CheckCollisionPointRec(mousePos, gearRec) && IsMouseButtonPressed(MOUSE_BUTTON_LEFT)) {
                selectedEquippedSlot = (int)i;
            }

            gearY += 75;
        }

        // Gem Inventory & Action Section (Right Column)
        DrawText("GEM INVENTORY & FORGE", uiX + 350, uiY + 55, 12, GOLD);
        int gemY = uiY + 80;

        for (size_t i = 0; i < gemInventory.size(); i++) {
            const auto& gem = gemInventory[i];
            Rectangle gemRec = { (float)uiX + 350, (float)gemY, 320.0f, 32.0f };
            bool isHovered = CheckCollisionPointRec(mousePos, gemRec);

            Color gemCol = (gem.type == GEM_RUBY) ? RED : ((gem.type == GEM_SAPPHIRE) ? SKYBLUE : GOLD);

            DrawRectangleRec(gemRec, isHovered ? GetColor(0x2A2A3EFF) : GetColor(0x1A1A28FF));
            DrawRectangleLinesEx(gemRec, 1.0f, isHovered ? gemCol : DARKGRAY);

            DrawCircle((int)gemRec.x + 16, (int)gemRec.y + 16, 6, gemCol);
            DrawText(gem.name.c_str(), (int)gemRec.x + 32, (int)gemRec.y + 10, 11, WHITE);
            DrawText(gem.GetStatDescription().c_str(), (int)gemRec.x + 170, (int)gemRec.y + 10, 10, GREEN);

            // Insert Button
            if (isHovered && IsMouseButtonPressed(MOUSE_BUTTON_LEFT) && !equippedGear.empty()) {
                if (InsertGemIntoItem(equippedGear[selectedEquippedSlot], gem)) {
                    gemInventory.erase(gemInventory.begin() + i);
                    break;
                }
            }

            gemY += 38;
        }

        // Unsocket & Fuse Buttons
        Rectangle unsocketBtn = { (float)uiX + 25, (float)uiY + uiH - 50, 140.0f, 32.0f };
        bool unsocketHover = CheckCollisionPointRec(mousePos, unsocketBtn);
        DrawRectangleRec(unsocketBtn, unsocketHover ? RED : GetColor(0x281818FF));
        DrawRectangleLinesEx(unsocketBtn, 1.0f, RED);
        DrawText("Unsocket All", (int)unsocketBtn.x + 22, (int)unsocketBtn.y + 10, 11, WHITE);

        if (unsocketHover && IsMouseButtonPressed(MOUSE_BUTTON_LEFT) && !equippedGear.empty()) {
            UnsocketGems(equippedGear[selectedEquippedSlot], gemInventory);
        }

        Rectangle fuseBtn = { (float)uiX + 180, (float)uiY + uiH - 50, 140.0f, 32.0f };
        bool fuseHover = CheckCollisionPointRec(mousePos, fuseBtn);
        DrawRectangleRec(fuseBtn, fuseHover ? GOLD : GetColor(0x282818FF));
        DrawRectangleLinesEx(fuseBtn, 1.0f, GOLD);
        DrawText("Fuse 3 Gems", (int)fuseBtn.x + 25, (int)fuseBtn.y + 10, 11, WHITE);

        if (fuseHover && IsMouseButtonPressed(MOUSE_BUTTON_LEFT)) {
            FuseGems(gemInventory, GEM_RUBY, GEM_TIER_CHIPPED);
        }
    }
#include "raylib.h"
